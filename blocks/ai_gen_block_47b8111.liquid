{% doc %}
  @prompt
    a product carousel pulling product tiles from a specific collection, it needs to pull in that red text for bundles that says what the price will be with the code, on the bundle collection page it shows the rrp and then what the price will be (20% pff) with the code. This is specific to the bundles page, can this gety shown in this bliock if a bundles collection is selected?#, add extra top margin, dafuq is that, please revert it
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign is_bundle_collection = false %}
{% if block.settings.collection != blank and block.settings.collection.handle contains 'bundle' %}{% assign is_bundle_collection = true %}{% endif %}
{% style %}
.ai-product-carousel-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }}}
.ai-product-carousel-{{ ai_gen_id }}__header{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:24px}.ai-product-carousel-{{ ai_gen_id }}__heading{margin:0;font-size:{{ block.settings.heading_size }}px;line-height:1.15;color:{{ block.settings.text_color }}}.ai-product-carousel-{{ ai_gen_id }}__view-all{color:{{ block.settings.text_color }};font-size:14px;font-weight:600;text-underline-offset:3px;white-space:nowrap}.ai-product-carousel-{{ ai_gen_id }}__viewport{overflow:hidden}.ai-product-carousel-{{ ai_gen_id }}__track{display:flex;gap:{{ block.settings.card_gap }}px;overflow-x:auto;scroll-behavior:smooth;scrollbar-width:none;padding-bottom:4px}.ai-product-carousel-{{ ai_gen_id }}__track::-webkit-scrollbar{display:none}.ai-product-carousel-{{ ai_gen_id }}__card{flex:0 0 calc((100% - ({{ block.settings.desktop_columns | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.desktop_columns }});min-width:0}.ai-product-carousel-{{ ai_gen_id }}__image-link{display:block;aspect-ratio:1/1;overflow:hidden;background:{{ block.settings.image_background }};border-radius:{{ block.settings.image_radius }}px}.ai-product-carousel-{{ ai_gen_id }}__image-link img,.ai-product-carousel-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:100%;object-fit:cover}.ai-product-carousel-{{ ai_gen_id }}__placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#666}.ai-product-carousel-{{ ai_gen_id }}__details{padding-top:12px}.ai-product-carousel-{{ ai_gen_id }}__title{display:block;margin:0 0 6px;color:{{ block.settings.text_color }};font-size:15px;line-height:1.35;text-decoration:none}.ai-product-carousel-{{ ai_gen_id }}__price{margin:0;color:{{ block.settings.text_color }};font-size:14px;font-weight:600}.ai-product-carousel-{{ ai_gen_id }}__bundle-price{margin:6px 0 0;color:{{ block.settings.bundle_text_color }};font-size:13px;line-height:1.35;font-weight:700}.ai-product-carousel-{{ ai_gen_id }}__controls{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}.ai-product-carousel-{{ ai_gen_id }}__button{width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;border:1px solid {{ block.settings.control_border }};border-radius:50%;background:{{ block.settings.control_background }};color:{{ block.settings.control_icon }};cursor:pointer}.ai-product-carousel-{{ ai_gen_id }}__button:hover{background:{{ block.settings.control_hover_background }}}.ai-product-carousel-{{ ai_gen_id }}__button:focus-visible,.ai-product-carousel-{{ ai_gen_id }} a:focus-visible{outline:2px solid {{ block.settings.text_color }};outline-offset:3px}.ai-product-carousel-{{ ai_gen_id }}__empty{padding:36px 20px;text-align:center;background:{{ block.settings.image_background }};color:#555}@media screen and (max-width:749px){.ai-product-carousel-{{ ai_gen_id }}__header{align-items:flex-start;flex-direction:column;margin-bottom:18px}.ai-product-carousel-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size | times: 0.85 }}px}.ai-product-carousel-{{ ai_gen_id }}__card{flex-basis:calc((100% - {{ block.settings.card_gap }}px)/2)}}
{% endstyle %}
<product-carousel-{{ ai_gen_id }} class="ai-product-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{% if block.settings.collection != blank %}<div class="ai-product-carousel-{{ ai_gen_id }}__header"><h2 class="ai-product-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% if block.settings.show_view_all %}<a class="ai-product-carousel-{{ ai_gen_id }}__view-all" href="{{ block.settings.collection.url }}">{{ block.settings.view_all_label | escape }}</a>{% endif %}</div><div class="ai-product-carousel-{{ ai_gen_id }}__viewport"><div class="ai-product-carousel-{{ ai_gen_id }}__track" data-track>{% for product in block.settings.collection.products limit:block.settings.product_limit %}<article class="ai-product-carousel-{{ ai_gen_id }}__card"><a class="ai-product-carousel-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url:width:700 }}" alt="{{ product.featured_image.alt | default:product.title | escape }}" loading="lazy" width="700" height="700">{% else %}<div class="ai-product-carousel-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</a><div class="ai-product-carousel-{{ ai_gen_id }}__details"><a class="ai-product-carousel-{{ ai_gen_id }}__title" href="{{ product.url }}">{{ product.title | escape }}</a><p class="ai-product-carousel-{{ ai_gen_id }}__price">{{ product.price | money }}</p>{% if block.settings.show_bundle_price and is_bundle_collection %}{% if product.metafields.custom.bundle_price != blank %}<p class="ai-product-carousel-{{ ai_gen_id }}__bundle-price">{{ product.metafields.custom.bundle_price.value | default:product.metafields.custom.bundle_price }}</p>{% else %}{% assign bundle_discount_multiplier = 100 | minus:block.settings.bundle_discount_percent %}{% assign bundle_price = product.price | times:bundle_discount_multiplier | divided_by:100.0 %}<p class="ai-product-carousel-{{ ai_gen_id }}__bundle-price">{{ block.settings.bundle_message_prefix | escape }} {{ bundle_price | money }} {{ block.settings.bundle_message_suffix | escape }}</p>{% endif %}{% endif %}</div></article>{% else %}<div class="ai-product-carousel-{{ ai_gen_id }}__empty">Choose a collection to display products.</div>{% endfor %}</div></div>{% if block.settings.show_controls %}<div class="ai-product-carousel-{{ ai_gen_id }}__controls"><button class="ai-product-carousel-{{ ai_gen_id }}__button" type="button" data-direction="previous" aria-label="Previous products">&#8592;</button><button class="ai-product-carousel-{{ ai_gen_id }}__button" type="button" data-direction="next" aria-label="Next products">&#8594;</button></div>{% endif %}{% else %}<div class="ai-product-carousel-{{ ai_gen_id }}__empty">Select a collection to display products.</div>{% endif %}</product-carousel-{{ ai_gen_id }}>
<script>(function(){class ProductCarousel{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('[data-track]');if(!this.track)return;this.querySelectorAll('[data-direction]').forEach((button)=>{button.addEventListener('click',()=>this.track.scrollBy({left:button.dataset.direction==='next'?this.track.clientWidth*.85:-this.track.clientWidth*.85,behavior:'smooth'}))})}}if(!customElements.get('product-carousel-{{ ai_gen_id }}'))customElements.define('product-carousel-{{ ai_gen_id }}',ProductCarousel{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Product carousel","tag":null,"class":"product-carousel-block","settings":[{"type":"header","content":"Content"},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"heading","label":"Heading","default":"Shop our collection"},{"type":"checkbox","id":"show_view_all","label":"Show view all link","default":true},{"type":"text","id":"view_all_label","label":"View all label","default":"View all"},{"type":"range","id":"product_limit","label":"Products to show","min":4,"max":20,"step":1,"default":8},{"type":"checkbox","id":"show_bundle_price","label":"Show bundle price text","default":true},{"type":"text","id":"bundle_message_prefix","label":"Bundle message prefix","default":"With code:"},{"type":"text","id":"bundle_message_suffix","label":"Bundle message suffix","default":"20% off"},{"type":"range","id":"bundle_discount_percent","label":"Bundle discount","min":5,"max":50,"step":5,"unit":"%","default":20},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_columns","label":"Cards on desktop","min":2,"max":6,"step":1,"default":4},{"type":"range","id":"card_gap","label":"Card spacing","min":8,"max":32,"step":4,"unit":"px","default":16},{"type":"checkbox","id":"show_controls","label":"Show arrow controls","default":true},{"type":"header","content":"Style"},{"type":"range","id":"heading_size","label":"Heading size","min":18,"max":48,"step":2,"unit":"px","default":28},{"type":"range","id":"image_radius","label":"Image radius","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"color","id":"text_color","label":"Text","default":"#181818"},{"type":"color","id":"bundle_text_color","label":"Bundle text","default":"#C62828"},{"type":"color","id":"image_background","label":"Image background","default":"#F3F3F3"},{"type":"color","id":"control_background","label":"Control background","default":"#FFFFFF"},{"type":"color","id":"control_hover_background","label":"Control hover","default":"#F0F0F0"},{"type":"color","id":"control_border","label":"Control border","default":"#B8B8B8"},{"type":"color","id":"control_icon","label":"Control icon","default":"#181818"}],"presets":[{"name":"Product carousel"}]}{% endschema %}