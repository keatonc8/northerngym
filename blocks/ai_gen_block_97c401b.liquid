{% doc %}
  @prompt
    Create an embedded section for a Blue Light Card discount page. The section should display a form where customers must enter their email address and click a submit button. Once submitted, a discount code "bluelight20" is revealed to them on the page. The form should include basic email validation, a friendly message before the form (e.g. "Enter your email to unlock your exclusive discount"), and a thank-you message shown after submission alongside the revealed code displayed prominently. The design should be clean and on-brand., right i want this email to consent to marketing and sync up with klaviyo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bluelight-discount-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-bluelight-discount__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-bluelight-discount__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 600;
  }

  .ai-bluelight-discount__message-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.message_spacing }}px;
    line-height: 1.5;
  }

  .ai-bluelight-discount__form-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: stretch;
    flex-wrap: wrap;
    margin-bottom: {{ block.settings.form_spacing }}px;
  }

  .ai-bluelight-discount__input-{{ ai_gen_id }} {
    flex: 1 1 250px;
    max-width: 400px;
    padding: 14px 16px;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.input_background }};
    transition: border-color 0.2s ease;
  }

  .ai-bluelight-discount__input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.button_background }};
  }

  .ai-bluelight-discount__input-{{ ai_gen_id }}:invalid:not(:placeholder-shown) {
    border-color: {{ block.settings.error_color }};
  }

  .ai-bluelight-discount__checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    text-align: left;
    max-width: 600px;
    margin: 0 auto {{ block.settings.message_spacing }}px;
  }

  .ai-bluelight-discount__checkbox-{{ ai_gen_id }} {
    margin-top: 2px;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: {{ block.settings.button_background }};
  }

  .ai-bluelight-discount__checkbox-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size | minus: 2 }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
    cursor: pointer;
  }

  .ai-bluelight-discount__button-{{ ai_gen_id }} {
    flex: 0 0 auto;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .ai-bluelight-discount__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-bluelight-discount__button-{{ ai_gen_id }}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ai-bluelight-discount__error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: {{ block.settings.text_size | minus: 2 }}px;
    margin-top: 8px;
    display: none;
  }

  .ai-bluelight-discount__error-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-bluelight-discount__success-{{ ai_gen_id }} {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-bluelight-discount__success-{{ ai_gen_id }}.active {
    display: block;
    opacity: 1;
  }

  .ai-bluelight-discount__thank-you-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size | plus: 2 }}px;
    color: {{ block.settings.success_color }};
    margin: 0 0 {{ block.settings.message_spacing }}px;
    font-weight: 500;
  }

  .ai-bluelight-discount__code-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.code_background }};
    border: 2px dashed {{ block.settings.code_border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.code_padding }}px;
    margin: 0 auto;
    max-width: 500px;
  }

  .ai-bluelight-discount__code-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size | minus: 2 }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-bluelight-discount__code-{{ ai_gen_id }} {
    font-size: {{ block.settings.code_size }}px;
    color: {{ block.settings.code_color }};
    font-weight: 700;
    margin: 0 0 12px;
    letter-spacing: 2px;
    font-family: monospace;
  }

  .ai-bluelight-discount__copy-button-{{ ai_gen_id }} {
    padding: 10px 24px;
    background-color: {{ block.settings.copy_button_background }};
    color: {{ block.settings.copy_button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.text_size | minus: 2 }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .ai-bluelight-discount__copy-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.copy_button_hover_background }};
  }

  .ai-bluelight-discount__copy-feedback-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size | minus: 4 }}px;
    color: {{ block.settings.success_color }};
    margin-top: 8px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .ai-bluelight-discount__copy-feedback-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-bluelight-discount__form-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-bluelight-discount__input-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-bluelight-discount__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-bluelight-discount__code-{{ ai_gen_id }} {
      font-size: {{ block.settings.code_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<bluelight-discount-{{ ai_gen_id }}
  class="ai-bluelight-discount-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-bluelight-discount__container-{{ ai_gen_id }}">
    <div class="ai-bluelight-discount__form-view-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-bluelight-discount__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.message != blank %}
        <div class="ai-bluelight-discount__message-{{ ai_gen_id }}">
          {{ block.settings.message }}
        </div>
      {% endif %}

      {% form 'customer', class: 'ai-bluelight-discount__form-{{ ai_gen_id }}', novalidate: 'novalidate' %}
        <input type="hidden" name="contact[tags]" value="bluelight-card,newsletter">
        <input type="hidden" name="contact[custom_property][discount_code]" value="{{ block.settings.discount_code }}">
        <input type="hidden" name="contact[custom_property][source]" value="Blue Light Card Page">
        
        <input
          type="email"
          name="contact[email]"
          class="ai-bluelight-discount__input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.email_placeholder }}"
          aria-label="Email address"
          aria-describedby="ai-bluelight-discount-error-{{ ai_gen_id }}"
          required
        >
        <button
          type="submit"
          class="ai-bluelight-discount__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </button>
      {% endform %}

      {% if block.settings.show_consent_checkbox %}
        <div class="ai-bluelight-discount__checkbox-wrapper-{{ ai_gen_id }}">
          <input
            type="checkbox"
            id="ai-bluelight-consent-{{ ai_gen_id }}"
            class="ai-bluelight-discount__checkbox-{{ ai_gen_id }}"
            checked
          >
          <label
            for="ai-bluelight-consent-{{ ai_gen_id }}"
            class="ai-bluelight-discount__checkbox-label-{{ ai_gen_id }}"
          >
            {{ block.settings.consent_text }}
          </label>
        </div>
      {% endif %}

      <div
        id="ai-bluelight-discount-error-{{ ai_gen_id }}"
        class="ai-bluelight-discount__error-{{ ai_gen_id }}"
        role="alert"
      >
        {{ block.settings.error_message }}
      </div>
    </div>

    <div class="ai-bluelight-discount__success-{{ ai_gen_id }}">
      {% if block.settings.thank_you_message != blank %}
        <p class="ai-bluelight-discount__thank-you-{{ ai_gen_id }}">
          {{ block.settings.thank_you_message }}
        </p>
      {% endif %}

      <div class="ai-bluelight-discount__code-container-{{ ai_gen_id }}">
        <p class="ai-bluelight-discount__code-label-{{ ai_gen_id }}">
          {{ block.settings.code_label }}
        </p>
        <p class="ai-bluelight-discount__code-{{ ai_gen_id }}">
          {{ block.settings.discount_code }}
        </p>
        <button
          type="button"
          class="ai-bluelight-discount__copy-button-{{ ai_gen_id }}"
          aria-label="Copy discount code"
        >
          {{ block.settings.copy_button_text }}
        </button>
        <p class="ai-bluelight-discount__copy-feedback-{{ ai_gen_id }}" aria-live="polite">
          {{ block.settings.copied_message }}
        </p>
      </div>
    </div>
  </div>
</bluelight-discount-{{ ai_gen_id }}>

<script>
  (function() {
    class BluelightDiscount{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('.ai-bluelight-discount__form-{{ ai_gen_id }}');
        this.emailInput = this.querySelector('.ai-bluelight-discount__input-{{ ai_gen_id }}');
        this.errorMessage = this.querySelector('.ai-bluelight-discount__error-{{ ai_gen_id }}');
        this.formView = this.querySelector('.ai-bluelight-discount__form-view-{{ ai_gen_id }}');
        this.successView = this.querySelector('.ai-bluelight-discount__success-{{ ai_gen_id }}');
        this.copyButton = this.querySelector('.ai-bluelight-discount__copy-button-{{ ai_gen_id }}');
        this.copyFeedback = this.querySelector('.ai-bluelight-discount__copy-feedback-{{ ai_gen_id }}');
        this.consentCheckbox = this.querySelector('.ai-bluelight-discount__checkbox-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.form.addEventListener('submit', this.handleSubmit.bind(this));
        this.emailInput.addEventListener('input', this.clearError.bind(this));
        if (this.copyButton) {
          this.copyButton.addEventListener('click', this.copyCode.bind(this));
        }
      }

      handleSubmit(event) {
        event.preventDefault();

        const email = this.emailInput.value.trim();
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!email || !emailPattern.test(email)) {
          this.showError();
          return;
        }

        this.clearError();
        this.submitToKlaviyo(email);
        this.submitToShopify();
      }

      submitToKlaviyo(email) {
        const klaviyoListId = '{{ block.settings.klaviyo_list_id }}';
        
        if (!klaviyoListId || klaviyoListId === '') {
          return;
        }

        const isConsented = this.consentCheckbox ? this.consentCheckbox.checked : true;

        const data = {
          email: email,
          custom_properties: {
            discount_code: '{{ block.settings.discount_code }}',
            source: 'Blue Light Card Page',
            blue_light_card_holder: true
          }
        };

        if (isConsented) {
          data.sms_consent = false;
          data.email_consent = true;
        }

        if (window._learnq) {
          window._learnq.push(['identify', { $email: email }]);
          window._learnq.push(['track', 'Blue Light Card Signup', {
            discount_code: '{{ block.settings.discount_code }}',
            source: 'Blue Light Card Page'
          }]);
        }

        const formData = new FormData();
        formData.append('g', klaviyoListId);
        formData.append('email', email);
        formData.append('$fields', '$consent');
        formData.append('$consent', JSON.stringify(['email']));

        fetch('https://manage.kmail-lists.com/ajax/subscriptions/subscribe', {
          method: 'POST',
          body: formData,
          mode: 'no-cors'
        }).catch(() => {});
      }

      submitToShopify() {
        const formData = new FormData(this.form);

        fetch('/contact', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/javascript'
          }
        }).then(() => {
          this.showSuccess();
        }).catch(() => {
          this.showSuccess();
        });
      }

      showError() {
        this.errorMessage.classList.add('active');
        this.emailInput.setAttribute('aria-invalid', 'true');
      }

      clearError() {
        this.errorMessage.classList.remove('active');
        this.emailInput.removeAttribute('aria-invalid');
      }

      showSuccess() {
        this.formView.style.display = 'none';
        this.successView.classList.add('active');
      }

      copyCode() {
        const codeText = '{{ block.settings.discount_code }}';

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(codeText).then(() => {
            this.showCopyFeedback();
          }).catch(() => {
            this.fallbackCopy(codeText);
          });
        } else {
          this.fallbackCopy(codeText);
        }
      }

      fallbackCopy(text) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        document.body.appendChild(textArea);
        textArea.select();
        try {
          document.execCommand('copy');
          this.showCopyFeedback();
        } catch (err) {
          console.error('Failed to copy code');
        }
        document.body.removeChild(textArea);
      }

      showCopyFeedback() {
        this.copyFeedback.classList.add('active');
        setTimeout(() => {
          this.copyFeedback.classList.remove('active');
        }, 2000);
      }
    }

    customElements.define('bluelight-discount-{{ ai_gen_id }}', BluelightDiscount{{ ai_gen_id }});
  })();
</script>

