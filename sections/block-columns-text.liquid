{% assign card_blocks = section.blocks | where: 'type', 'card' %}
{% assign has_card_blocks = card_blocks.size | plus: 0 %}

{% assign has_product_columns_with_text = false %}

{%- comment -%}
  Pull metafields safely for both contexts
{%- endcomment -%}
{% assign mf_columns_with_text = blank %}

{% if product != blank %}
  {% assign mf_columns_with_text = product.metafields.custom.product_columns_with_text %}
{% endif %}

{% if collection != blank %}
  {%- comment -%}
    Collection fallback if product metafield is empty
  {%- endcomment -%}
  {% if mf_columns_with_text == blank or mf_columns_with_text.value == blank or mf_columns_with_text.value.size == 0 %}
    {% assign mf_columns_with_text = collection.metafields.custom.product_columns_with_text %}
  {% endif %}
{% endif %}

{%- comment -%}
  Determine if we have anything to show
{%- endcomment -%}
{% if mf_columns_with_text != blank and mf_columns_with_text.value != blank and mf_columns_with_text.value.size != 0 %}
  {% assign has_product_columns_with_text = true %}
{% endif %}

{% if has_card_blocks > 0 or has_product_columns_with_text %}

<style>
  /* Hide scrollbar for the carousel track */
  #campaignTrack-{{ section.id }}::-webkit-scrollbar { display: none; }
  #campaignTrack-{{ section.id }} { scrollbar-width: none; -ms-overflow-style: none; }

  .{{ section.id }}.block-columns-text {
    /* Background (color + opacity) */
    {% assign bg = section.settings.section_bg_color %}
    {% assign a  = section.settings.section_bg_opacity | divided_by: 100.0 %}
    {% assign r = bg | color_extract: 'red' %}
    {% assign g = bg | color_extract: 'green' %}
    {% assign b = bg | color_extract: 'blue' %}

    --section-bg: rgba({{ r }}, {{ g }}, {{ b }}, {{ a }});
    background-color: var(--section-bg);

    /* Text + button colours */
    --heading-color: {{ section.settings.heading_color }};
    --body-color: {{ section.settings.body_text_color }};
    --btn-bg: {{ section.settings.button_bg_color }};
    --btn-text: {{ section.settings.button_text_color }};

    /* Spacing */
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .{{ section.id }}.block-columns-text .col-title { color: var(--heading-color); }
  .{{ section.id }}.block-columns-text .col-body { color: var(--body-color); }

  .{{ section.id }}.block-columns-text .col-btn {
    background-color: var(--btn-bg);
    color: var(--btn-text);
  }
</style>

<section class="{{ section.id }} block-columns-text">
  <div class="mx-auto container-limited px-6">

    <!-- Mobile carousel / Desktop grid -->
    <div class="relative">
      <div
        id="campaignTrack-{{ section.id }}"
        data-snap-carousel
        data-snap-breakpoint="md"
        data-snap-start-index="0"
        class="
          -mx-6 flex gap-6 overflow-x-auto px-6 pb-3
          snap-x snap-mandatory scroll-px-6
          md:mx-0 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:px-0 md:pb-0
        "
      >
        {% for block in section.blocks %}
          {% assign img = block.settings.image %}
          {% assign title = block.settings.title %}
          {% assign link = block.settings.button_link %}

          <div
            class="
              group relative shrink-0 overflow-hidden
              w-[95%] sm:w-[70%] md:w-auto md:shrink
              snap-start
            "
            {{ block.shopify_attributes }}
          >
            <div class="aspect-[1/1] w-full overflow-hidden rounded-2xl bg-zinc-200 ring-1 ring-black/5">
              {% if img != blank %}
                {{
                  img
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '375, 550, 750, 1100, 1500, 2000',
                    sizes: '(min-width: 768px) 33vw, 85vw',
                    class: 'h-full w-full object-cover transition-transform duration-[4000ms] ease-out group-hover:scale-110',
                    alt: img.alt | default: title
                }}
              {% else %}
                <div class="h-full w-full bg-zinc-200"></div>
              {% endif %}
            </div>

            <div class="flex flex-col items-start justify-between py-6">
              {% if title != blank %}
                <h3 class="col-title text-2xl font-normal tracking-tight">{{ title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="col-body my-4 leading-6 text-base mb-4">
                  {{ block.settings.text | truncatewords: 50 }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a
                  href="{{ link | default: '#' }}"
                  class="col-btn inline-flex items-center rounded-full px-6 py-3 text-base font-medium mt-auto w-max"
                >
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Pagination (mobile only) -->
      <div
        class="mt-6 flex items-center justify-center gap-2 md:hidden"
        data-snap-dots
        aria-label="Carousel pagination"
      ></div>
    </div>

  </div>
</section>

{% endif %}

{% schema %}
{
  "name": "Block - Columns with Text",
  "tag": "section",
  "class": "section section-block-columns-text",
  "settings": [
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "section_bg_opacity",
      "label": "Background Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Body Text Color",
      "default": "#737373"
    },

    {
      "type": "header",
      "content": "Button Colours"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#111111"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Enter title here"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "(Max 50 Words)",
          "default": "<p>Lorem ipsum dolor sit amet consectetur. At morbi semper egestas tortor. Lobortis vivamus amet pharetra dictum ante ullamcorper sit risus.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Discover More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Block - Columns with Text",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}