{% assign heading = section.settings.heading | default: 'Password' %}
{% assign paragraph = section.settings.paragraph %}
{% assign password_placeholder = section.settings.password_placeholder | default: 'Enter Password' %}
{% assign button_text = section.settings.button_text | default: 'Enter' %}

<section 
   class="h-screen relative"
>
   <div class="container-lg h-full">
      <div class="flex justify-center text-center items-center h-full w-full">
         <div class="flex flex-col gap-5 pb-40 w-full">
            <div class="flex flex-col gap-2">
               {% if heading != blank %}
                  <h1 class="heading text-45">
                     {{ heading }}
                  </h1>
               {% endif %}
               {% if paragraph != blank %}
                  <p>
                     {{ paragraph }}
                  </p>
               {% endif %}
            </div>
         
            {% form 'storefront_password', class: 'flex flex-col gap-4 max-w-[400px] w-full mx-auto' %}
               {{ form.errors | default_errors }}
         
               <input type="password" name="password" placeholder="{{ password_placeholder }}" class="border border-silver py-2 px-5">
               <button type="submit" class="button button-black">
                  {{ button_text }}
               </button>
            {% endform %}
         </div>
      </div>
   </div>
</section>

{% schema %}
   {
      "name": "Password",
      "settings": [
         {
            "type": "header",
            "content": "Content"
         },
         {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "We're launching soon"
         },
         {
            "type": "text",
            "id": "paragraph",
            "label": "Paragraph",
            "default": "Sign in below if you have the password"
         },
         {
            "type": "text",
            "id": "password_placeholder",
            "label": "Password Placeholder",
            "default": "Enter Password"
         },
         {
            "type": "text",
            "id": "button_text",
            "label": "Button Text",
            "default": "Enter"
         }
      ],
      "blocks": [],
      "presets": []
   }
   {% endschema %}