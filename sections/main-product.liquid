{% assign info_strip_delivery_text = section.settings.info_strip_delivery_text %}
{% assign info_strip_pay_options_text = section.settings.info_strip_pay_options_text %}
{% assign is_bulk_quantity_template = false %}
{% if template.suffix == 'bulk-quantity' %}
   {% assign is_bulk_quantity_template = true %}
{% endif %}

<div class="container-full"
   x-data="{
      product: {{ product | json | escape }},
      selectedOptions: {{ product.selected_or_first_available_variant.options | json | escape }},
      selectedVariant: {{ product.selected_or_first_available_variant | json | escape }},
      qty: 1,
      isBulkQuantityTemplate: {{ is_bulk_quantity_template | json }},
      currencyCode: {{ localization.country.currency.iso_code | json | escape }},

      init() {
         const params = new URLSearchParams(window.location.search);
         const variantId = params.get('variant');

         if (variantId) {
            const match = this.product.variants.find(v => v.id.toString() === variantId);
            if (match) {
               this.selectedOptions = [...match.options];
               this.selectedVariant = match;
            }
         }

         // Wait for Glide to mount before syncing
         this.$refs.productImages.addEventListener('glide-mounted', () => {
            setTimeout(() => this.updateVariant(), 50);
         });

         // If Glide already mounted, sync immediately
         if (this.$refs.productImages.dataset.jsIsMounted !== undefined) {
            this.updateVariant();
         }
      },

      updateOption(index, value, productUrl) {
         this.selectedOptions[index] = value;

         // If Combined Listings provided a child URL, hard-navigate to it.
         if (productUrl) {
            window.location.assign(productUrl);
            return;
         }

         // Fallback to normal variant swap (non-combined products).
         this.updateVariant();
      },

      updateVariant() {
         const match = this.product.variants.find(v =>
            v.options.join('|') === this.selectedOptions.join('|')
         );

         if (!match) return;

         this.selectedVariant = match;

         const idInput = this.$refs.variant_id;
         if (idInput) idInput.value = match.id;

         const addBtn = this.$refs.add_button;
         if (addBtn && !this.isBulkQuantityTemplate) addBtn.disabled = !match.available;

         // Update URL
         const url = new URL(window.location.href);
         url.searchParams.set('variant', match.id);
         window.history.replaceState({}, '', url);

         // Sync Glide to first matching image
         const slides = Array.from(
            this.$refs.productImages.querySelectorAll('[data-variant-id]:not(.glide__slide--clone)')
         );

         const targetId = match.id.toString();
         const slideIndex = slides.findIndex((el, i) =>
            el.dataset.variantId === targetId &&
            slides[i - 1]?.dataset.variantId !== targetId
         );

         if (slideIndex >= 0) {
            const glide = this.$refs.productImages._glide?.instance;
            if (glide) {
               glide.go(`=${slideIndex}`);
               // console.log('[Glide] Jumped to variant slide:', slideIndex);
            }
         }
      },

      addToCart() {
         const formData = new FormData(this.$refs.product_form);
         fetch('/cart/add.js', {
            method: 'POST',
            body: formData
         })
         .then(res => res.json())
         .then(() => {
            this.$dispatch('cart-updated');
            this.$dispatch('toggle-cart');
         })
         .catch(err => console.error('Add to cart error:', err));
      },

      formatPrice(cents) {
         return new Intl.NumberFormat('en-GB', {
            style: 'currency',
            currency: this.currencyCode || 'GBP'
         }).format(cents / 100);
      }
   }"
   @quantity-changed.window="qty = $event.detail.quantity"
>
   <div class="{{ top_section_classes }} items-center hidden lg:flex">
         {% render 'product-breadcrumbs' %}
      </div>
   <div class="pdp-main-wrap relative flex flex-col md:flex-row">
