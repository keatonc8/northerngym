                     </svg>
                  </span>
                  <span class="inline-flex flex-col">
                     <span class="font-semibold">Selling Fast</span>
                     <span>{{ product.metafields.custom.selling_fast_tag.value }}</span>
                  </span>
               </div>
            </div>
            <script src="{{ 'sellingfast.js' | asset_url }}" defer></script>

         {% endif %}
         <style>
            /* Hide scrollbar but allow scrolling */
            .gallery-dekstop {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;     /* Firefox */

               height:calc(100vh - 170px);
            }

            .gallery-dekstop::-webkit-scrollbar {
            display: none;             /* Chrome, Safari */
            }
         </style>
         <div class="md:hidden">
            {% render 'product-images-mobile' %}
             {%- render 'swish', component: 'save', context: 'pdp' -%}  
         </div>
         <div class="hidden md:block overflow-y-auto gallery-dekstop">

            {%- render 'swish', component: 'save', context: 'pdp' -%}   
    {% render 'product-images' %}
</div>
      </div>
      <div class="w-full" data-module="product-details-scroll">
         {% render 'product-details',
            collection: collection,
            section_settings: section.settings,
            section_blocks: section.blocks,
            info_strip_delivery_text: info_strip_delivery_text,
            info_strip_pay_options_text: info_strip_pay_options_text
         %}
      </div>
   </div>
   
</div>

<script>
   (() => {
      const section = document.currentScript.previousElementSibling;
      if (!section) return;

      const initStickyFooterObserver = () => {
         const footer = document.querySelector('footer');
         const stickyBar = section.querySelector('.add-top-cart-pdp-wrap');

         if (!footer || !stickyBar) return;

         const desktopMq = window.matchMedia('(min-width: 1024px)');

         const setStickyBarVisibility = (hidden) => {
            if (desktopMq.matches) {
               stickyBar.style.opacity = '';
               stickyBar.style.pointerEvents = '';
               return;
            }

            stickyBar.style.opacity = hidden ? '0' : '1';
            stickyBar.style.pointerEvents = hidden ? 'none' : '';
         };

         const observer = new IntersectionObserver((entries) => {
            const entry = entries[0];
            setStickyBarVisibility(entry.isIntersecting);
         }, {
            root: null,
            threshold: 0
         });

         observer.observe(footer);

         const handleViewportChange = () => {
            setStickyBarVisibility(false);
         };

         if (desktopMq.addEventListener) {
            desktopMq.addEventListener('change', handleViewportChange);
         } else if (desktopMq.addListener) {
            desktopMq.addListener(handleViewportChange);
         }
      };

      if (document.readyState === 'loading') {
         document.addEventListener('DOMContentLoaded', initStickyFooterObserver, { once: true });
      } else {
         initStickyFooterObserver();
      }
   })();
</script>

