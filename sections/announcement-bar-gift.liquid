{% comment %}
=====================================================================
  CUSTOM CODE — FREE GIFT ANNOUNCEMENT BAR
  Added: 10 Jul 2026
  Updated: 14 Jul 2026 — bar now sits fixed directly BELOW the header
  (both mobile and desktop), instead of above it. Header is sticky at
  the very top; the bar is fixed at a top offset equal to the header's
  real rendered height, measured by the script below.
  Purpose: Sticky bar announcing the £100 spend / free gift offer.
  Safe to delete: yes — this is a standalone section. To remove,
  delete this file and remove the two lines marked
  "CUSTOM CODE - GIFT BAR" in layout/theme.liquid.
  Edit the wording in Theme Editor > this section's block settings,
  no code change needed for copy changes.
=====================================================================
{% endcomment %}

<style>
  .gift-bar {
    width: 100%;
    background: #000;
    color: #fff;
    padding: 8px 0;
    text-align: center;
    font-family: 'Roboto Mono', monospace;
    letter-spacing: 0.05em;
    font-size: 12px;
    position: fixed;
    left: 0;
    right: 0;
    top: var(--header-h, 69px);
    z-index: 49;
  }
  .gift-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 16px;
  }
  .gift-bar__icon {
    width: 16px;
    height: 16px;
    flex: none;
    color: #ffc30b;
    display: inline-flex;
  }
  .gift-bar__icon svg { width: 100%; height: 100%; }
  .gift-bar__text {
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .gift-bar__text p { display: inline; margin: 0; }
  .gift-bar__text strong { color: #ffc30b; }

  /* Legacy leading spacer from theme.liquid — no longer used now the bar sits below the header */
  #gift-bar-spacer { display: none !important; height: 0 !important; }

  /* Trailing spacer reserves room so page content doesn't sit under the fixed bar */
  #gift-bar-spacer-mobile {
    display: block;
    height: var(--gift-bar-h, 34px);
  }

  header {
    position: sticky !important;
    top: 0 !important;
    z-index: 50;
  }
</style>

<div class="gift-bar" id="gift-bar">
  <div class="gift-bar__inner">
    <span class="gift-bar__icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="8" width="18" height="4"></rect>
        <path d="M12 8v13"></path>
        <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"></path>
        <path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8"></path>
        <path d="M16.5 8a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8"></path>
      </svg>
    </span>
    <span class="gift-bar__text">{{ section.settings.gift_bar_text }}</span>
  </div>
</div>

<div id="gift-bar-spacer-mobile"></div>

<script>
(function () {
  var bar = document.getElementById('gift-bar');
  if (!bar) return;

  var spacer = document.getElementById('gift-bar-spacer-mobile');

  function measureHeader() {
    var header = document.querySelector('header');
    if (header) {
      document.documentElement.style.setProperty('--header-h', header.getBoundingClientRect().height + 'px');
    }
  }

  function measureBar() {
    var barH = bar.getBoundingClientRect().height || 34;
    document.documentElement.style.setProperty('--gift-bar-h', barH + 'px');
    if (spacer) spacer.style.height = barH + 'px';
  }

  // Measure immediately — the header is already in the DOM by the time this
  // inline script runs (it's rendered earlier in the page), so there's no
  // need to wait for DOMContentLoaded or load. Waiting for 'load' (which
  // blocks on every image) was the cause of the visible half-cut flash.
  measureHeader();
  measureBar();

  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      measureHeader();
      measureBar();
    }, 100);
  }, { passive: true });

  // Re-check once fonts/images have finished settling, in case the header
  // or bar reflows slightly (e.g. web font swap changing text height).
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(function () {
      measureHeader();
      measureBar();
    });
  }
  window.addEventListener('load', function () {
    measureHeader();
    measureBar();
  });
})();
</script>

{% schema %}
{
  "name": "Gift Announcement Bar",
  "settings": [
    {
      "type": "richtext",
      "id": "gift_bar_text",
      "label": "Announcement text",
      "default": "<p>Spend <strong>£100</strong> &amp; unlock a free gift worth <strong>£20</strong></p>"
    }
  ],
  "blocks": []
}
{% endschema %}
