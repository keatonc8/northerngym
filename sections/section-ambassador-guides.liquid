{% assign heading = section.settings.heading %}
{% assign paragraph = section.settings.paragraph %}

{% render 'ambassador-guides'
   heading: heading,
   paragraph: paragraph,
   section_blocks: section.blocks,
%}

{% schema %}
{
   "name": "Ambassador Guides",
   "settings": [
      {
         "type": "header",
         "content": "Settings"
      },
      {
         "type": "header",
         "content": "Content"
      },
      {
         "type": "text",
         "id": "heading",
         "label": "Heading"
      },
      {
         "type": "textarea",
         "id": "paragraph",
         "label": "Paragraph"
      }
   ],
   "blocks": [
      {
         "type": "guide",
         "name": "Guide",
         "settings": [
            {
               "type": "header",
               "content": "Content"
            },
            {
               "type": "image_picker",
               "id": "image",
               "label": "Image"
            },
            {
               "type": "text",
               "id": "heading",
               "label": "Title"
            },
            {
               "type": "url",
               "id": "link",
               "label": "Link"
            },
            {
               "type": "text",
               "id": "link_text",
               "label": "Link Text",
               "default": "Find Out More"
            }
         ]
      }
   ],
   "presets": [{
      "name": "Ambassador Guides",
      "blocks": []
   }]
}
{% endschema %}