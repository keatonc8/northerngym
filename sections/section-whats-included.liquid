{%- liquid
  assign hero_image = section.settings.hero_image
  if hero_image == blank and section.settings.use_product_image
    assign hero_image = product.featured_image
  endif
  assign hero_alt = section.settings.hero_title | default: product.title | default: shop.name
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --wi-gap: {{ section.settings.gap }}px;
    --wi-radius: {{ section.settings.radius }}px;
    --wi-cols: {{ section.settings.columns }};
    --wi-card-bg: {{ section.settings.card_bg }};
    --wi-border: {{ section.settings.card_border }};
    --wi-text: {{ section.settings.text_color }};
    --wi-muted: {{ section.settings.muted_color }};
    --wi-chip: {{ section.settings.chip_bg }};
    --wi-dark-bg: {{ section.settings.dark_bg }};
    --wi-dark-text: {{ section.settings.dark_text }};
    --wi-dark-muted: {{ section.settings.dark_muted }};
    --wi-hero-ar: {{ section.settings.hero_ratio }};
    background: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .wi__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .wi__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 24px 40px;
    align-items: start;
    margin-bottom: 28px;
  }
  #shopify-section-{{ section.id }} .wi__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wi-muted);
  }
  #shopify-section-{{ section.id }} .wi__heading {
    margin: 0;
    color: var(--wi-text);
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  #shopify-section-{{ section.id }} .wi__intro {
    color: var(--wi-muted);
    font-size: 16px;
    line-height: 1.5;
    padding-top: 6px;
  }
  #shopify-section-{{ section.id }} .wi__intro p { margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .wi__intro p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .wi__grid {
    display: grid;
    grid-template-columns: repeat(var(--wi-cols), minmax(0, 1fr));
    gap: var(--wi-gap);
  }
  #shopify-section-{{ section.id }} .wi__hero {
    grid-row: span 2;
    display: grid;
    border-radius: var(--wi-radius);
    overflow: hidden;
    background: var(--wi-card-bg);
    min-height: 220px;
  }
  #shopify-section-{{ section.id }} .wi__hero > * { grid-area: 1 / 1; }
  #shopify-section-{{ section.id }} .wi__hero-img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--wi-hero-ar);
    object-fit: cover;
    max-width: none;
  }
  #shopify-section-{{ section.id }} .wi__hero-cap {
    align-self: end;
    padding: 18px;
    color: #fff;
    background: linear-gradient(to top, rgba(0,0,0,0.62), rgba(0,0,0,0.18) 55%, rgba(0,0,0,0));
  }
  #shopify-section-{{ section.id }} .wi__hero-title {
    margin: 0;
    font-size: 17px;
    line-height: 1.25;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .wi__hero-sub {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.35;
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .wi__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 190px;
    padding: 18px;
    box-sizing: border-box;
    border-radius: var(--wi-radius);
    background: var(--wi-card-bg);
    border: 1px solid var(--wi-border);
    color: var(--wi-text);
  }
  #shopify-section-{{ section.id }} .wi__card--dark {
    background: var(--wi-dark-bg);
    border-color: var(--wi-dark-bg);
    color: var(--wi-dark-text);
  }
  #shopify-section-{{ section.id }} .wi__card--wide { grid-column: span 2; }
  #shopify-section-{{ section.id }} .wi__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--wi-chip);
    color: inherit;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .wi__card--dark .wi__chip { background: rgba(255,255,255,0.14); }
  #shopify-section-{{ section.id }} .wi__chip svg { width: 22px; height: 22px; display: block; }
  #shopify-section-{{ section.id }} .wi__chip img { width: 24px; height: 24px; object-fit: contain; display: block; }
  #shopify-section-{{ section.id }} .wi__dots { display: flex; gap: 7px; align-items: center; height: 44px; }
  #shopify-section-{{ section.id }} .wi__dot { width: 12px; height: 12px; border-radius: 50%; display: block; }
  #shopify-section-{{ section.id }} .wi__text { margin-top: auto; }
  #shopify-section-{{ section.id }} .wi__title {
    margin: 0;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  #shopify-section-{{ section.id }} .wi__sub {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.35;
    color: var(--wi-muted);
  }
  #shopify-section-{{ section.id }} .wi__card--dark .wi__sub { color: var(--wi-dark-muted); }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .wi__head {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      margin-bottom: 20px;
    }
    #shopify-section-{{ section.id }} .wi__grid { grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr)); }
    #shopify-section-{{ section.id }} .wi__hero { grid-column: 1 / -1; grid-row: auto; }
    #shopify-section-{{ section.id }} .wi__card--wide { grid-column: 1 / -1; }
    #shopify-section-{{ section.id }} .wi__card { min-height: 0; }
  }
{%- endstyle -%}

<div class="wi">
  <div class="wi__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="wi__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="wi__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="wi__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.intro != blank -%}
          <div class="wi__intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="wi__grid">
      {%- if section.settings.show_hero and hero_image != blank -%}
        <div class="wi__hero">
          {{ hero_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(max-width: 989px) 100vw, 30vw', class: 'wi__hero-img', alt: hero_alt }}
          {%- if section.settings.hero_title != blank or section.settings.hero_subtitle != blank -%}
            <div class="wi__hero-cap">
              {%- if section.settings.hero_title != blank -%}
                <p class="wi__hero-title">{{ section.settings.hero_title | escape }}</p>
              {%- endif -%}
              {%- if section.settings.hero_subtitle != blank -%}
                <p class="wi__hero-sub">{{ section.settings.hero_subtitle | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- capture icon_svg -%}
          {%- case block.settings.icon -%}
            {%- when 'spring' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12h2l2-6 2.5 12L12 6l2.5 12L17 6l2 6h2"/></svg>
            {%- when 'bar' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9h18M6 9v11M18 9v11M3 14h18"/></svg>
            {%- when 'rope' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="6" r="3"/><path d="M9.5 8.5 7 14a5 5 0 0 0 10 0l-2.5-5.5M9 20h6"/></svg>
            {%- when 'crate' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5 12 12l9-4.5M12 12v9"/></svg>
            {%- when 'box' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 9h16v11H4z"/><path d="M4 9l2.2-5h11.6L20 9M12 9v11"/></svg>
            {%- when 'balance' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v16M5 20h14M7 8h10"/><path d="M7 8 4 14h6zM17 8l-3 6h6z"/></svg>
            {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 7h12v9H2zM14 10h4l4 3.5V16h-8z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
            {%- when 'ruler' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h18v8H3z"/><path d="M7 8v4M11 8v3M15 8v4M19 8v3"/></svg>
            {%- when 'check' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m4 12.5 5 5L20 6.5"/></svg>
            {%- when 'tools' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14.5 4.5a4 4 0 0 0 5 5L21 8a6 6 0 0 1-8 7L6 21l-3-3 6-7a6 6 0 0 1 7-8z"/></svg>
          {%- endcase -%}
        {%- endcapture -%}

        <div class="wi__card{% if block.settings.style == 'dark' %} wi__card--dark{% endif %}{% if block.settings.width == 'wide' %} wi__card--wide{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.show_dots -%}
            <div class="wi__dots">
              {%- if block.settings.dot_1 != blank -%}<span class="wi__dot" style="background:{{ block.settings.dot_1 }}"></span>{%- endif -%}
              {%- if block.settings.dot_2 != blank -%}<span class="wi__dot" style="background:{{ block.settings.dot_2 }}"></span>{%- endif -%}
              {%- if block.settings.dot_3 != blank -%}<span class="wi__dot" style="background:{{ block.settings.dot_3 }}"></span>{%- endif -%}
              {%- if block.settings.dot_4 != blank -%}<span class="wi__dot" style="background:{{ block.settings.dot_4 }}"></span>{%- endif -%}
              {%- if block.settings.dot_5 != blank -%}<span class="wi__dot" style="background:{{ block.settings.dot_5 }}"></span>{%- endif -%}
            </div>
          {%- elsif block.settings.custom_icon != blank -%}
            <span class="wi__chip">{{ block.settings.custom_icon | image_url: width: 48 | image_tag: loading: 'lazy', width: 24, height: 24, alt: '' }}</span>
          {%- elsif icon_svg != blank -%}
            <span class="wi__chip">{{ icon_svg }}</span>
          {%- endif -%}

          <div class="wi__text">
            {%- if block.settings.title != blank -%}
              <p class="wi__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="wi__sub">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "What's included",
  "tag": "section",
  "class": "section-whats-included",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's included" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything that arrives at your door." },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Every reformer arrives complete and ready to use. Nothing else to buy.</p>" },
    { "type": "header", "content": "Main image tile" },
    { "type": "checkbox", "id": "show_hero", "label": "Show main image tile", "default": true },
    { "type": "checkbox", "id": "use_product_image", "label": "Use product featured image when no image is set", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Image" },
    { "type": "text", "id": "hero_title", "label": "Image tile title", "default": "The reformer" },
    { "type": "text", "id": "hero_subtitle", "label": "Image tile subtitle", "default": "Your chosen finish, fully assembled" },
    { "type": "select", "id": "hero_ratio", "label": "Image shape", "options": [ { "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "3/4", "label": "Portrait (3:4)" }, { "value": "4/3", "label": "Landscape (4:3)" } ], "default": "4/5" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "mobile_columns", "label": "Columns (mobile)", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "2" },
    { "type": "range", "id": "gap", "label": "Gap between tiles", "min": 6, "max": 32, "step": 2, "default": 12, "unit": "px" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 28, "step": 2, "default": 12, "unit": "px" },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1600, "step": 20, "default": 1200, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_color", "label": "Secondary text", "default": "#737373" },
    { "type": "color", "id": "card_bg", "label": "Tile background", "default": "#f5f5f5" },
    { "type": "color", "id": "card_border", "label": "Tile border", "default": "#ebebeb" },
    { "type": "color", "id": "chip_bg", "label": "Icon background", "default": "#e8e8e8" },
    { "type": "color", "id": "dark_bg", "label": "Dark tile background", "default": "#111111" },
    { "type": "color", "id": "dark_text", "label": "Dark tile text", "default": "#ffffff" },
    { "type": "color", "id": "dark_muted", "label": "Dark tile secondary text", "default": "#bdbdbd" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Included item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Included item" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "none", "label": "None" }, { "value": "spring", "label": "Springs" }, { "value": "bar", "label": "Foot bar" }, { "value": "rope", "label": "Rope and pulley" }, { "value": "balance", "label": "Balance" }, { "value": "box", "label": "Box" }, { "value": "crate", "label": "Wooden crate" }, { "value": "truck", "label": "Delivery" }, { "value": "ruler", "label": "Measurement" }, { "value": "tools", "label": "Tools" }, { "value": "check", "label": "Tick" } ], "default": "check" },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon (overrides icon above)" },
        { "type": "header", "content": "Colour swatches" },
        { "type": "checkbox", "id": "show_dots", "label": "Show colour dots instead of an icon", "default": false },
        { "type": "color", "id": "dot_1", "label": "Dot 1" },
        { "type": "color", "id": "dot_2", "label": "Dot 2" },
        { "type": "color", "id": "dot_3", "label": "Dot 3" },
        { "type": "color", "id": "dot_4", "label": "Dot 4" },
        { "type": "color", "id": "dot_5", "label": "Dot 5" },
        { "type": "header", "content": "Tile style" },
        { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ], "default": "light" },
        { "type": "select", "id": "width", "label": "Tile width", "options": [ { "value": "normal", "label": "Standard" }, { "value": "wide", "label": "Double width" } ], "default": "normal" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "What's included",
      "blocks": [
        { "type": "feature", "settings": { "title": "Resistance springs", "subtitle": "Red, yellow and green loads", "show_dots": true, "dot_1": "#c8102e", "dot_2": "#f2c200", "dot_3": "#2e9e50", "icon": "spring" } },
        { "type": "feature", "settings": { "title": "Foot bar and rests", "subtitle": "Adjustable positions, padded", "icon": "bar" } },
        { "type": "feature", "settings": { "title": "Rope system", "subtitle": "Full pulley and handle set", "icon": "rope" } },
        { "type": "feature", "settings": { "title": "Spring board", "subtitle": "Fitted as standard", "icon": "box" } },
        { "type": "feature", "settings": { "title": "Balance box", "subtitle": "Included in the box", "icon": "balance" } },
        { "type": "feature", "settings": { "title": "Delivered in a secure wooden crate", "subtitle": "Braced and protected in transit", "icon": "crate", "style": "dark" } }
      ]
    }
  ]
}
{% endschema %}
