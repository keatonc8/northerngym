{% assign section_heading = section.settings.heading %}
{% assign section_text = section.settings.text %}
{% assign section_id = 'video-testimonials-' | append: section.id %}

{% if section_heading != blank or section_text != blank or section.blocks.size > 0 %}
  <section
    id="{{ section_id }}"
    class="overflow-hidden"
    style="
      --section-background-color: {{ section.settings.background_color }};
      --section-text-color: {{ section.settings.text_color }};
      --section-product-button-background: {{ section.settings.product_button_background }};
      --section-product-button-text-color: {{ section.settings.product_button_text_color }};
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background: var(--section-background-color);
      color: var(--section-text-color);
    "
    data-video-testimonials
  >
    <div class="container-sm">
      {% if section_heading != blank or section_text != blank %}
        <div class="mb-6 max-w-[44rem]">
          {% if section_heading != blank %}
            <h2 class="heading-03">
              {{ section_heading }}
            </h2>
          {% endif %}

          {% if section_text != blank %}
            <div class="text-lg mt-4 text-grey">
              {{ section_text }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="relative">
          <div
            class="grid grid-flow-col gap-4 overflow-x-auto pb-2 snap-x snap-mandatory [grid-auto-columns:calc((100%_-_0.5rem)_/_1.5)] [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden md:[grid-auto-columns:calc((100%_-_3rem)_/_4)]"
            data-track
          >
            {% for block in section.blocks %}
              {% assign poster_image = block.settings.poster_image %}
              {% assign hosted_video = block.settings.hosted_video %}
              {% assign external_video = block.settings.external_video %}
              {% assign has_video = false %}

              {% if poster_image == blank and hosted_video != blank %}
                {% assign poster_image = hosted_video.preview_image %}
              {% endif %}

              {% if hosted_video != blank or external_video != blank %}
                {% assign has_video = true %}
              {% endif %}

              <div class="snap-start" {{ block.shopify_attributes }}>
                <div class="block w-full text-left">
                  <span class="relative block aspect-[5/8] w-full overflow-hidden rounded-[1rem] bg-[#d9d9d9]">
                    {% if poster_image != blank %}
                      {{
                        poster_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'block h-full w-full object-cover',
                          loading: 'lazy',
                          alt: block.settings.title | default: poster_image.alt
                      }}
                    {% else %}
                      <span class="block h-full w-full bg-[#d0d0d0] bg-[linear-gradient(135deg,rgba(255,255,255,0.2),transparent)]"></span>
                    {% endif %}

                    <span class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0.02)_0%,rgba(0,0,0,0.16)_100%)]" aria-hidden="true"></span>

                    {% if has_video or poster_image != blank %}
                      <button
                        type="button"
                        class="absolute inset-0 block h-full w-full cursor-pointer border-0 bg-transparent p-0 appearance-none"
                        data-open-modal="{{ block.id }}"
                        aria-label="Open testimonial {{ block.settings.title | escape }}"
                      >
                        {% if has_video %}
                          <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
                            <svg width="30" height="34" viewBox="0 0 20 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M18 10.2679C19.3333 11.0377 19.3333 12.9623 18 13.7321L3 22.3923C1.66667 23.1621 0 22.1998 0 20.6603L0 3.33975C0 1.80015 1.66667 0.8379 3 1.6077L18 10.2679Z" fill="transparent" stroke="white" stroke-width="1"/>
                            </svg>
                          </span>
                        {% else %}
                          <span class="pointer-events-none absolute right-3 top-3 flex h-10 w-10 items-center justify-center rounded-full bg-black/30 text-white backdrop-blur-md">
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                              <path d="M6.75 2.25H2.25V6.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              <path d="M2.25 2.25L7.5 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                              <path d="M11.25 15.75H15.75V11.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              <path d="M15.75 15.75L10.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                          </span>
                        {% endif %}
                      </button>
                    {% endif %}
                  </span>

                  <span class="block pt-4 lg:p-4 pb-0">
                    {% if block.settings.title != blank %}
                      <span class="m-0 block font-heading text-[1.2rem] leading-[1.1] text-[var(--section-text-color)]">{{ block.settings.title }}</span>
                    {% endif %}

                    {% if block.settings.caption != blank %}
                      <span class="mt-[0.45rem] block text-base leading-[1.4] text-[rgba(33,33,33,0.66)]">{{ block.settings.caption }}</span>
                    {% endif %}

                    {% if block.settings.handle != blank %}
                      <span class="mt-[0.35rem] block text-base italic leading-[1.3] text-[var(--section-text-color)]">{{ block.settings.handle }}</span>
                    {% endif %}
                  </span>
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="mt-6 flex items-center justify-center md:hidden">
            <div class="flex items-center justify-center gap-2" data-dots></div>
          </div>
        </div>
      {% endif %}
    </div>

    {% for block in section.blocks %}
      {% assign poster_image = block.settings.poster_image %}
      {% assign hosted_video = block.settings.hosted_video %}
      {% assign external_video = block.settings.external_video %}
      {% assign sidebar_heading = block.settings.sidebar_heading | default: 'Products featured in this video' %}
      {% assign video_type = '' %}
      {% assign embed_url = '' %}
      {% assign hosted_video_src = '' %}

      {% if hosted_video != blank %}
        {% assign video_type = 'hosted' %}
        {% for source in hosted_video.sources %}
          {% if source.mime_type contains 'mp4' or source.format == 'mp4' %}
            {% assign hosted_video_src = source.url %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if hosted_video_src == blank and hosted_video.sources.size > 0 %}
          {% assign hosted_video_src = hosted_video.sources.first.url %}
        {% endif %}

        {% if poster_image == blank %}
          {% assign poster_image = hosted_video.preview_image %}
        {% endif %}
      {% elsif external_video != blank %}
        {% assign video_type = 'external' %}
        {% if external_video.type == 'youtube' %}
          {% assign embed_url = 'https://www.youtube.com/embed/' | append: external_video.id | append: '?autoplay=1&playsinline=1&rel=0&enablejsapi=1' %}
        {% elsif external_video.type == 'vimeo' %}
          {% assign embed_url = 'https://player.vimeo.com/video/' | append: external_video.id | append: '?autoplay=1&playsinline=1' %}
        {% endif %}
      {% elsif poster_image != blank %}
        {% assign video_type = 'image' %}
      {% endif %}

      {% if video_type != blank %}
        <div
          class="fixed inset-0 z-[60] bg-[rgba(17,17,17,0.72)] backdrop-blur-[8px] md:p-8"
          data-modal="{{ block.id }}"
          data-video-type="{{ video_type }}"
          data-video-src="{{ hosted_video_src }}"
          data-video-embed="{{ embed_url }}"
          data-video-provider="{% if external_video != blank %}{{ external_video.type }}{% endif %}"
          data-video-poster="{% if poster_image != blank %}{{ poster_image | image_url: width: 1600 }}{% endif %}"
          data-image-alt="{{ block.settings.title | default: poster_image.alt | escape }}"
          hidden
          aria-hidden="true"
        >
        <div class="relative h-full w-full overflow-hidden bg-white md:mx-auto md:h-[min(52rem,calc(100vh-4rem))] md:max-h-[calc(100vh-4rem)] md:w-fit md:rounded-[1.75rem]" role="dialog" aria-modal="true" aria-label="{{ block.settings.title | escape }}">
          <button
            type="button"
            class="absolute right-4 top-4 z-[25] inline-flex h-[3.25rem] w-[3.25rem] items-center justify-center rounded-full border-0 bg-white/95 text-[#111] md:hidden"
            data-close-modal
            aria-label="Close testimonial"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4.5 4.5L13.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M13.5 4.5L4.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>

          <div class="h-full md:grid md:max-h-[calc(100vh-4rem)] md:grid-cols-[minmax(0,1fr)_26rem] min-[1100px]:grid-cols-[minmax(0,1fr)_28rem]">
            <div class="relative h-full min-h-full bg-[#111] md:flex md:min-h-0 md:w-fit md:max-w-full md:items-stretch md:justify-center md:justify-self-center md:overflow-hidden">
              <div class="relative h-full w-full md:h-full md:w-auto md:max-h-full md:max-w-full md:aspect-[9/16]">
                <div class="h-full w-full" data-video-mount></div>

                <div class="pointer-events-none absolute bottom-4 left-4 right-4 z-10 rounded-[1rem] border border-white/16 bg-[rgba(44,38,32,0.45)] p-4 text-white opacity-0 transition-opacity duration-200 backdrop-blur-[14px]" data-video-meta-overlay>
                  <div class="grid grid-cols-[4.25rem_minmax(0,1fr)] items-center gap-[0.9rem]">
                    <div>
                      {% if poster_image != blank %}
                        {{
                          poster_image
                          | image_url: width: 200
                          | image_tag:
                            class: 'aspect-square w-full rounded-[0.9rem] bg-white/15 object-cover',
                            loading: 'lazy',
                            alt: block.settings.title | default: poster_image.alt
                        }}
                      {% else %}
                        <div class="aspect-square w-full rounded-[0.9rem] bg-white/15"></div>
                      {% endif %}
                    </div>

                    <div>
                      {% if block.settings.title != blank %}
                        <p class="m-0 text-lg leading-[1.05] text-white">{{ block.settings.title }}</p>
                      {% endif %}

                      {% if block.settings.caption != blank %}
                        <p class="mt-[0.35rem] text-base leading-[1.4] text-white/90">{{ block.settings.caption }}</p>
                      {% endif %}

                      {% if block.settings.handle != blank %}
                        <p class="mt-[0.2rem] text-base italic leading-[1.3] text-white/95">{{ block.settings.handle }}</p>
                      {% endif %}
                    </div>
                  </div>

                  <button
                    type="button"
                    class="mt-4 inline-flex min-h-[3.25rem] w-full items-center justify-center rounded-full border-0 bg-white px-[1.1rem] py-[0.95rem] text-base text-[#111] md:hidden"
                    data-open-products
                  >
                    {{ section.settings.mobile_products_button_label }}
                  </button>
                </div>

                <div class="pointer-events-none absolute inset-0 z-20 opacity-0 transition-opacity duration-200 md:hidden" data-mobile-products aria-hidden="true">
                  <div class="absolute inset-0 bg-[rgba(17,17,17,0.44)] backdrop-blur-[5px]" data-close-products></div>

                  <div class="absolute inset-x-0 bottom-0 flex max-h-[76vh] flex-col rounded-t-[1.75rem] bg-white p-5">
                    <div class="mb-1 flex items-center justify-between gap-4">
                      <h3 class="m-0 font-heading text-lg leading-[1.05] text-[#111]">
                        {{ sidebar_heading }}
                      </h3>

                      <button
                        type="button"
                        class="inline-flex h-11 w-11 items-center justify-center rounded-full border-0 bg-[#f2f2f2] text-[#111]"
                        data-close-products
                        aria-label="Close products"
                      >
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M4.5 4.5L13.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          <path d="M13.5 4.5L4.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>

                    {% if block.settings.modal_text != blank %}
                      <p class="mb-4 mt-2 text-base leading-[1.5] text-[rgba(33,33,33,0.68)]">{{ block.settings.modal_text }}</p>
                    {% endif %}

                    {% if block.settings.products != blank %}
                      <div class="min-h-0 flex-1 overflow-y-auto">
                        <div class="grid content-start gap-4">
                          {% for product in block.settings.products %}
                            {% assign product_form_id = section_id | append: '-mobile-product-form-' | append: block.id | append: '-' | append: product.id %}
                            <article class="grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-4 rounded-[1.25rem] p-[0.9rem]">
                              <a href="{{ product.url }}" aria-label="{{ product.title }}">
                                {% if product.featured_image != blank %}
                                  {{
                                    product.featured_image
                                    | image_url: width: 300
                                    | image_tag:
                                      class: 'aspect-square w-full rounded-2xl bg-[#ececec] object-cover',
                                      loading: 'lazy',
                                      alt: product.title
                                  }}
                                {% else %}
                                  <div class="aspect-square w-full rounded-2xl bg-[#ececec]"></div>
                                {% endif %}
                              </a>

                              <div>
                                <p class="mb-[0.35rem] text-base leading-[1.3] text-[#111]">{{ product.title }}</p>
                                <p class="m-0 text-[0.95rem] text-[rgba(33,33,33,0.72)]">
                                  {% if product.compare_at_price > product.price %}
                                    <span>{% unless product.has_only_default_variant %}from {% endunless %}{{ product.price | money }}</span>
                                    <span style="margin-left: 0.35rem; text-decoration: line-through; opacity: 0.6;">
                                      {{ product.compare_at_price | money }}
                                    </span>
                                  {% else %}
                                    {% unless product.has_only_default_variant %}from {% endunless %}{{ product.price | money }}
                                  {% endif %}
                                </p>
                                {% if product.has_only_default_variant %}
                                  <div
                                    x-data="{
                                      addToCart() {
                                        const formData = new FormData(this.$refs.productForm);
                                        fetch('/cart/add.js', {
                                          method: 'POST',
                                          body: formData
                                        })
                                        .then((res) => res.json())
                                        .then(() => {
                                          this.$dispatch('cart-updated');
                                          this.$dispatch('toggle-cart');
                                          this.$dispatch('video-testimonials:product-added');
                                        })
                                        .catch((err) => console.error('Add to cart error:', err));
                                      }
                                    }"
                                  >
                                    {%- form 'product', product, id: product_form_id, class: 'w-full', novalidate: 'novalidate', x-ref: 'productForm' -%}
                                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                                      <input type="hidden" name="quantity" value="1">
                                      <button
                                        type="submit"
                                        class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-full px-4 py-[0.8rem] text-[0.95rem] leading-none transition-opacity duration-200 hover:opacity-90 disabled:cursor-not-allowed disabled:bg-[#f2f2f2] disabled:text-[#111] disabled:hover:opacity-100"
                                        style="background: {% if product.selected_or_first_available_variant.available %}var(--section-product-button-background){% else %}#eeeeee{% endif %}; color: {% if product.selected_or_first_available_variant.available %}var(--section-product-button-text-color){% else %}#111111{% endif %};"
                                        name="add"
                                        @click.prevent="addToCart()"
                                        {%- unless product.selected_or_first_available_variant.available -%}disabled{%- endunless -%}
                                      >
                                        {%- if product.selected_or_first_available_variant.available -%}
                                          Add to cart
                                        {%- else -%}
                                          Sold out
                                        {%- endif -%}
                                      </button>
                                    {%- endform -%}
                                  </div>
                                {% else %}
                                  <a href="{{ product.url }}" class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#111] px-4 py-[0.8rem] text-[0.95rem] leading-none text-white transition-opacity duration-200 hover:opacity-90">
                                    View options
                                  </a>
                                {% endif %}
                              </div>
                            </article>
                          {% endfor %}
                        </div>
                      </div>
                    {% else %}
                      <div class="border-t border-[rgba(33,33,33,0.08)] pt-4 text-[0.9rem] text-[rgba(33,33,33,0.68)]">
                        Add products to this card in the theme editor to populate the product list.
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>

            <aside class="hidden min-h-0 flex-col gap-1 border-l border-[rgba(33,33,33,0.08)] bg-white p-3 md:flex min-[1100px]:p-3">
              <button
                type="button"
                class="mb-3 ml-auto inline-flex h-[3.25rem] w-[3.25rem] items-center justify-center rounded-full border-0 bg-[#f2f2f2] text-[#111]"
                data-close-modal
                aria-label="Close testimonial"
              >
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4.5 4.5L13.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <path d="M13.5 4.5L4.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>

              {% if sidebar_heading != blank %}
                <h3 class="m-0 font-heading text-lg leading-[1.05] text-[#111]">{{ sidebar_heading }}</h3>
              {% endif %}

              {% if block.settings.modal_text != blank %}
                <p class="mt-2 text-base leading-[1.5] text-[rgba(33,33,33,0.68)]">{{ block.settings.modal_text }}</p>
              {% endif %}

              {% if block.settings.products != blank %}
                <div class="mt-3 grid min-h-0 flex-1 content-start gap-8 overflow-y-auto pr-1">
                  {% for product in block.settings.products %}
                    {% assign product_form_id = section_id | append: '-desktop-product-form-' | append: block.id | append: '-' | append: product.id %}
                    <article class="grid grid-cols-[5.5rem_minmax(0,1fr)] h-full items-start gap-3 rounded-[1.25rem]">
                      <a href="{{ product.url }}" aria-label="{{ product.title }}" class="h-full bg-[#f4f4f4] rounded-[12px] flex items-center">
                        {% if product.featured_image != blank %}
                          {{
                            product.featured_image
                            | image_url: width: 300
                            | image_tag:
                              class: 'aspect-square w-full rounded-2xl bg-[#ececec] object-cover',
                              loading: 'lazy',
                              alt: product.title
                          }}
                        {% else %}
                          <div class="aspect-square w-full rounded-2xl bg-[#ececec]"></div>
                        {% endif %}
                      </a>

                      <div>
                        <p class="mb-[0.35rem] text-base leading-[1.3] text-[#111]">{{ product.title }}</p>
                        <p class="m-0 text-[0.95rem] text-[rgba(33,33,33,0.72)]">
                          {% if product.compare_at_price > product.price %}
                            <span>{% unless product.has_only_default_variant %}from {% endunless %}{{ product.price | money }}</span>
                            <span style="margin-left: 0.35rem; text-decoration: line-through; opacity: 0.6;">
                              {{ product.compare_at_price | money }}
                            </span>
                          {% else %}
                            {% unless product.has_only_default_variant %}from {% endunless %}{{ product.price | money }}
                          {% endif %}
                        </p>
                        {% if product.has_only_default_variant %}
                          <div
                            x-data="{
                              addToCart() {
                                const formData = new FormData(this.$refs.productForm);
                                fetch('/cart/add.js', {
                                  method: 'POST',
                                  body: formData
                                })
                                .then((res) => res.json())
                                .then(() => {
                                  this.$dispatch('cart-updated');
                                  this.$dispatch('toggle-cart');
                                  this.$dispatch('video-testimonials:product-added');
                                })
                                .catch((err) => console.error('Add to cart error:', err));
                              }
                            }"
                          >
                            {%- form 'product', product, id: product_form_id, class: 'w-full', novalidate: 'novalidate', x-ref: 'productForm' -%}
                              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                              <input type="hidden" name="quantity" value="1">
                              <button
                                type="submit"
                                class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-full px-4 py-[0.8rem] text-[0.95rem] leading-none transition-opacity duration-200 hover:opacity-90 disabled:cursor-not-allowed disabled:bg-[#f2f2f2] disabled:text-[#111] disabled:hover:opacity-100"
                                style="background: {% if product.selected_or_first_available_variant.available %}var(--section-product-button-background){% else %}#eeeeee{% endif %}; color: {% if product.selected_or_first_available_variant.available %}var(--section-product-button-text-color){% else %}#111111{% endif %};"
                                name="add"
                                @click.prevent="addToCart()"
                                {%- unless product.selected_or_first_available_variant.available -%}disabled{%- endunless -%}
                              >{%- if product.selected_or_first_available_variant.available -%}
                                  Add to cart
                                {%- else -%}
                                  Sold out
                                {%- endif -%}
                              </button>
                            {%- endform -%}
                          </div>
                        {% else %}
                          <a href="{{ product.url }}" class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#111] px-4 py-[0.8rem] text-[0.95rem] leading-none text-white transition-opacity duration-200 hover:opacity-90">
                            View options
                          </a>
                        {% endif %}
                      </div>
                    </article>
                  {% endfor %}
                </div>
              {% else %}
                <div class="mt-3 border-t border-[rgba(33,33,33,0.08)] pt-4 text-[0.9rem] text-[rgba(33,33,33,0.68)]">
                  Add products to this card in the theme editor to populate the sidebar.
                </div>
              {% endif %}
            </aside>
          </div>
        </div>
        </div>
      {% endif %}
    {% endfor %}
  </section>

  <script>
    (() => {
      const selector = '#{{ section_id }}';
      const bodyClass = 'overflow-hidden';
      const mobileBreakpoint = window.matchMedia('(max-width: 767px)');
      const hoverCapableDesktop = window.matchMedia('(min-width: 768px) and (hover: hover) and (pointer: fine)');
      const dotBaseClasses = ['h-2.5', 'rounded-full', 'border-0', 'transition-[width,background-color]', 'duration-200'];

      function setDotState(dot, isActive) {
        dot.classList.remove(...dotBaseClasses);
        dot.classList.add(...dotBaseClasses);
        dot.style.width = isActive ? '2rem' : '0.625rem';
        dot.style.backgroundColor = isActive ? '#000000' : 'rgba(33, 33, 33, 0.22)';
      }

      function postToYouTube(iframe, command) {
        if (!iframe || !iframe.contentWindow) return;
        iframe.contentWindow.postMessage(JSON.stringify({
          event: 'command',
          func: command,
          args: []
        }), '*');
      }

      function setHostedVideoToggleState(button, isPaused) {
        if (!button) return;

        const showWhilePlaying = button.dataset.hoverVisible === 'true' && hoverCapableDesktop.matches;
        const isVisible = isPaused || showWhilePlaying;

        button.setAttribute('aria-label', isPaused ? 'Play video' : 'Pause video');
        button.setAttribute('data-state', isPaused ? 'paused' : 'playing');
        button.classList.toggle('opacity-0', !isVisible);
        button.classList.toggle('pointer-events-none', !isVisible);
        button.classList.toggle('opacity-100', isVisible);
        button.classList.toggle('pointer-events-auto', isVisible);

        const icon = button.querySelector('[data-video-toggle-icon]');
        if (!icon) return;

        if (isPaused) {
          icon.innerHTML = `
            <svg width="30" height="34" viewBox="0 0 20 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M18 10.2679C19.3333 11.0377 19.3333 12.9623 18 13.7321L3 22.3923C1.66667 23.1621 0 22.1998 0 20.6603L0 3.33975C0 1.80015 1.66667 0.8379 3 1.6077L18 10.2679Z" fill="transparent" stroke="white" stroke-width="1"/>
            </svg>
          `;
          return;
        }

        icon.innerHTML = `
          <svg width="26" height="30" viewBox="0 0 26 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="4" y="3" width="6" height="24" rx="3" fill="white"/>
            <rect x="16" y="3" width="6" height="24" rx="3" fill="white"/>
          </svg>
        `;
      }

      function syncHostedVideoToggle(modal) {
        if (!modal) return;

        const video = modal.querySelector('video');
        const button = modal.querySelector('[data-video-toggle]');
        const metaOverlay = modal.querySelector('[data-video-meta-overlay]');
        if (!video || !button) return;

        setHostedVideoToggleState(button, video.paused);

        if (metaOverlay) {
          metaOverlay.classList.remove('opacity-0', 'pointer-events-none');
          metaOverlay.classList.add('opacity-100', 'pointer-events-auto');
        }
      }

      function pauseModalMedia(modal) {
        if (!modal) return;
        const video = modal.querySelector('video');
        const iframe = modal.querySelector('iframe');
        const provider = modal.getAttribute('data-video-provider');

        if (video) {
          video.pause();
          syncHostedVideoToggle(modal);
        }

        if (iframe && provider === 'youtube') {
          postToYouTube(iframe, 'pauseVideo');
        }
      }

      function playModalMedia(modal) {
        if (!modal) return;
        const video = modal.querySelector('video');
        const iframe = modal.querySelector('iframe');
        const provider = modal.getAttribute('data-video-provider');

        if (video) {
          const promise = video.play();
          if (promise && typeof promise.catch === 'function') {
            promise
              .then(() => {
                syncHostedVideoToggle(modal);
              })
              .catch(() => {})
            ;
          } else {
            syncHostedVideoToggle(modal);
          }
        }

        if (iframe && provider === 'youtube') {
          postToYouTube(iframe, 'playVideo');
        }
      }

      function mountVideo(modal) {
        if (!modal) return;

        const mount = modal.querySelector('[data-video-mount]');
        if (!mount || mount.dataset.loaded === 'true') return;

        const videoType = modal.getAttribute('data-video-type');
        const videoSrc = modal.getAttribute('data-video-src');
        const videoEmbed = modal.getAttribute('data-video-embed');
        const videoPoster = modal.getAttribute('data-video-poster');
        const imageAlt = modal.getAttribute('data-image-alt') || '';

        if (videoType === 'image' && videoPoster) {
          const metaOverlay = modal.querySelector('[data-video-meta-overlay]');
          const image = document.createElement('img');
          image.className = 'block h-full w-full bg-[#111] object-cover';
          image.src = videoPoster;
          image.alt = imageAlt;
          image.loading = 'eager';
          mount.appendChild(image);
          mount.dataset.loaded = 'true';

          if (metaOverlay) {
            metaOverlay.classList.remove('opacity-0', 'pointer-events-none');
            metaOverlay.classList.add('opacity-100', 'pointer-events-auto');
          }

          return;
        }

        if (videoType === 'external' && videoEmbed) {
          const iframe = document.createElement('iframe');
          iframe.className = 'block h-full w-full border-0 bg-[#111] object-cover';
          iframe.src = videoEmbed;
          iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          iframe.allowFullscreen = true;
          iframe.setAttribute('title', 'Video testimonial');
          mount.appendChild(iframe);
          mount.dataset.loaded = 'true';
          return;
        }

        if (videoType === 'hosted' && videoSrc) {
          const wrapper = document.createElement('div');
          wrapper.className = 'relative h-full w-full';

          const video = document.createElement('video');
          video.className = 'block h-full w-full bg-[#111] object-cover';
          video.src = videoSrc;
          video.controls = false;
          video.autoplay = true;
          video.playsInline = true;
          video.preload = 'metadata';
          if (videoPoster) video.poster = videoPoster;

          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-200';
          toggle.setAttribute('data-video-toggle', '');

          const icon = document.createElement('span');
          icon.className = 'pointer-events-none inline-flex items-center justify-center';
          icon.setAttribute('data-video-toggle-icon', '');
          toggle.appendChild(icon);

          wrapper.addEventListener('mouseenter', () => {
            if (!hoverCapableDesktop.matches) return;
            toggle.dataset.hoverVisible = 'true';
            syncHostedVideoToggle(modal);
          });

          wrapper.addEventListener('mouseleave', () => {
            toggle.dataset.hoverVisible = 'false';
            syncHostedVideoToggle(modal);
          });

          toggle.addEventListener('click', () => {
            if (video.paused) {
              const promise = video.play();
              if (promise && typeof promise.catch === 'function') {
                promise
                  .then(() => {
                    syncHostedVideoToggle(modal);
                  })
                  .catch(() => {})
                ;
              } else {
                syncHostedVideoToggle(modal);
              }
              return;
            }

            video.pause();
            syncHostedVideoToggle(modal);
          });

          video.addEventListener('click', () => {
            if (video.paused) {
              const promise = video.play();
              if (promise && typeof promise.catch === 'function') {
                promise
                  .then(() => {
                    syncHostedVideoToggle(modal);
                  })
                  .catch(() => {})
                ;
              } else {
                syncHostedVideoToggle(modal);
              }
              return;
            }

            video.pause();
            syncHostedVideoToggle(modal);
          });

          video.addEventListener('play', () => syncHostedVideoToggle(modal));
          video.addEventListener('pause', () => syncHostedVideoToggle(modal));
          video.addEventListener('ended', () => syncHostedVideoToggle(modal));

          wrapper.appendChild(video);
          wrapper.appendChild(toggle);
          mount.appendChild(wrapper);
          mount.dataset.loaded = 'true';
          syncHostedVideoToggle(modal);
        }
      }

      function unmountVideo(modal) {
        if (!modal) return;
        const mount = modal.querySelector('[data-video-mount]');
        if (!mount) return;
        mount.innerHTML = '';
        delete mount.dataset.loaded;
      }

      function closeProductsOverlay(modal, shouldResume) {
        if (!modal) return;
        const overlay = modal.querySelector('[data-mobile-products]');
        if (!overlay) return;

        overlay.classList.remove('pointer-events-auto', 'opacity-100');
        overlay.classList.add('pointer-events-none', 'opacity-0');
        overlay.setAttribute('aria-hidden', 'true');

        if (shouldResume && mobileBreakpoint.matches) {
          playModalMedia(modal);
        }
      }

      function openProductsOverlay(modal) {
        if (!modal) return;
        const overlay = modal.querySelector('[data-mobile-products]');
        if (!overlay) return;

        overlay.classList.remove('pointer-events-none', 'opacity-0');
        overlay.classList.add('pointer-events-auto', 'opacity-100');
        overlay.setAttribute('aria-hidden', 'false');
        pauseModalMedia(modal);
      }

      function initSection(section) {
        if (!section || section.dataset.videoTestimonialsInit === 'true') return;
        section.dataset.videoTestimonialsInit = 'true';

        const track = section.querySelector('[data-track]');
        const dotsWrap = section.querySelector('[data-dots]');
        const cards = track ? Array.from(track.children) : [];
        let activeModal = null;
        let activeTrigger = null;
        let pages = [];

        const getMaxScrollLeft = () => {
          if (!track) return 0;
          return Math.max(track.scrollWidth - track.clientWidth, 0);
        };

        const getPagePositions = () => {
          if (!track || !cards.length) return [];

          const positions = [];
          const maxScrollLeft = getMaxScrollLeft();

          cards.forEach((card) => {
            const left = Math.min(card.offsetLeft, maxScrollLeft);
            if (!positions.length || Math.abs(positions[positions.length - 1] - left) > 2) {
              positions.push(left);
            }
          });

          if (!positions.length) {
            positions.push(0);
          }

          if (Math.abs(positions[positions.length - 1] - maxScrollLeft) > 2) {
            positions.push(maxScrollLeft);
          }

          return positions;
        };

        const buildDots = () => {
          if (!track || !dotsWrap || !cards.length) return;

          pages = getPagePositions();
          dotsWrap.innerHTML = '';

          pages.forEach((position, index) => {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = '';
            setDotState(dot, index === 0);
            dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
            dot.addEventListener('click', () => {
              track.scrollTo({
                left: position,
                behavior: 'smooth'
              });
            });
            dotsWrap.appendChild(dot);
          });
        };

        const updateDots = () => {
          if (!track || !dotsWrap || !pages.length) return;

          const scrollLeft = track.scrollLeft;
          const activeIndex = pages.reduce((bestIndex, position, index) => {
            const delta = Math.abs(position - scrollLeft);
            const currentDelta = Math.abs(pages[bestIndex] - scrollLeft);
            return delta < currentDelta ? index : bestIndex;
          }, 0);

          Array.from(dotsWrap.children).forEach((dot, index) => {
            setDotState(dot, index === activeIndex);
            dot.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
          });
        };

        if (track && dotsWrap && cards.length) {
          buildDots();
          track.addEventListener('scroll', () => window.requestAnimationFrame(updateDots), { passive: true });
          window.addEventListener('resize', () => {
            buildDots();
            updateDots();
          });
          updateDots();
        }

        const openModal = (modal, trigger) => {
          if (!modal) return;

          activeModal = modal;
          activeTrigger = trigger || null;
          modal.hidden = false;
          modal.setAttribute('aria-hidden', 'false');
          document.body.classList.add(bodyClass);
          mountVideo(modal);
          closeProductsOverlay(modal, false);

          const closeButton = modal.querySelector('[data-close-modal]');
          if (closeButton) closeButton.focus();
        };

        const closeModal = (modal = activeModal) => {
          if (!modal) return;

          closeProductsOverlay(modal, false);
          pauseModalMedia(modal);
          modal.hidden = true;
          modal.setAttribute('aria-hidden', 'true');
          unmountVideo(modal);
          document.body.classList.remove(bodyClass);

          if (activeTrigger) activeTrigger.focus();

          activeModal = null;
          activeTrigger = null;
        };

        section.querySelectorAll('[data-open-modal]').forEach((trigger) => {
          trigger.addEventListener('click', () => {
            const modalId = trigger.getAttribute('data-open-modal');
            const modal = section.querySelector(`[data-modal="${modalId}"]`);
            openModal(modal, trigger);
          });
        });

        section.addEventListener('video-testimonials:product-added', (event) => {
          const modal = event.target.closest('[data-modal]');
          if (modal) closeModal(modal);
        });

        section.querySelectorAll('[data-close-modal]').forEach((button) => {
          button.addEventListener('click', () => closeModal(button.closest('[data-modal]')));
        });

        section.querySelectorAll('[data-modal]').forEach((modal) => {
          modal.addEventListener('click', (event) => {
            if (event.target === modal) closeModal(modal);
          });

          const openProductsButton = modal.querySelector('[data-open-products]');
          const closeProductsButtons = modal.querySelectorAll('[data-close-products]');

          if (openProductsButton) {
            openProductsButton.addEventListener('click', () => {
              openProductsOverlay(modal);
            });
          }

          closeProductsButtons.forEach((button) => {
            button.addEventListener('click', () => {
              closeProductsOverlay(modal, true);
            });
          });
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || !activeModal) return;

          const productsOverlay = activeModal.querySelector('[data-mobile-products]');
          if (productsOverlay && productsOverlay.classList.contains('opacity-100')) {
            closeProductsOverlay(activeModal, true);
            return;
          }

          closeModal(activeModal);
        });
      }

      const boot = (root = document) => {
        root.querySelectorAll(selector).forEach(initSection);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => boot());
      } else {
        boot();
      }

      document.addEventListener('shopify:section:load', (event) => {
        boot(event.target);
      });
    })();
  </script>
