{% render 'abu-styles' %}
<div class="abu-scope">
  <div class="abu-dark" style="background:#111111;">
    <div class="abu-container" style="padding-top:4.5rem;padding-bottom:3rem;">
      <div style="max-width:56rem;">
        {% if section.settings.eyebrow != blank %}
          <span class="abu-meta" style="color:rgba(255,255,255,0.55);">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h1 class="abu-h01" style="margin-top:0.75rem;">{{ section.settings.heading }}</h1>
        {% if section.settings.lede != blank %}
          <p style="margin-top:1.25rem;font-size:1.125rem;color:rgba(255,255,255,0.75);">{{ section.settings.lede }}</p>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="abu-media abu-wide">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw' }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Block - About Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "About Us" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Bold a word to highlight it.",
      "default": "<p>Northern. <strong>Built to Work.</strong></p>"
    },
    { "type": "text", "id": "lede", "label": "Sub-line", "default": "Fitness is easy. Just work really hard." },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [
    { "name": "Block - About Hero" }
  ]
}
{% endschema %}
