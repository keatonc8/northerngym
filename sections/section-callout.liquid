{% assign heading = section.settings.heading %}
{% assign show_logo = section.settings.show_logo %}
{% assign button_url = section.settings.button_url %}
{% assign button_text = section.settings.button_text | default: "Click here" %}
{% assign main_image = section.settings.main_image %}

<div class="container-full">
   <div class="flex flex-col-reverse lg:flex-row bg-black text-white">
      <div class="flex flex-col gap-30 justify-between w-full lg:w-1/2 py-8 container relative">
         <div class="relative z-2">
            {% render 'icons', icon: 'logo', class: 'w-24' %}
         </div>
         <div class="flex flex-col gap-6 relative z-2">
            <h2 class="heading-03 lg:max-w-118">
               {{ heading }}
            </h2>
            <a href="{{ button_url }}" class="button button-yellow-alt sm:mr-auto">
               {{ button_text }}
            </a>
         </div>
         {% render 'arrow-gradient' %}
      </div>
      <div class="w-full lg:w-1/2 lg:h-160">
         {% render 'responsive-image',
            image_object: main_image,
            size: 'half',
            class: 'w-full h-full object-cover'
         %}
      </div>
   </div>
</div>

{% schema %}
{
   "name": "Callout",
   "settings": [
      {
         "type": "header",
         "content": "Settings"
      },
      {
         "type": "checkbox",
         "id": "show_logo",
         "label": "Show Logo?",
         "info": "Show logo in the top left corner",
         "default": true
      },
      {
         "type": "header",
         "content": "Content"
      },
      {
         "type": "text",
         "id": "heading",
         "label": "Heading"
      },
      {
         "type": "url",
         "id": "button_url",
         "label": "Button URL"
      },
      {
         "type": "text",
         "id": "button_text",
         "label": "Button text"
      },
      {
         "type": "image_picker",
         "id": "main_image",
         "label": "Image"
      }
   ],
   "blocks": [],
   "presets": [{
      "name": "Callout",
      "blocks": []
   }]
}
{% endschema %}