{% comment %}
  ============================================================
  NORTHERN GYM EQUIPMENT - REFORMER PAYBACK CALCULATOR
  Section: section-reformer-payback
  ------------------------------------------------------------
  Minimal, calm calculator: how long a reformer takes to pay
  for itself vs paying per class. Reformer price comes from the
  product it is placed on, so currency follows the market.
  Prices and frequency are typed into number fields.
  Place it on a product template alongside the "Video showcase"
  section for the full reformer page.
  ============================================================
{% endcomment %}

{% assign section_id = 'reformer-payback-' | append: section.id %}

{% if section.settings.show_calculator %}
  {%- assign rp_price = 0 -%}
  {%- if product and product.price > 0 -%}
    {%- assign rp_price = product.price -%}
  {%- elsif section.settings.fallback_price > 0 -%}
    {%- assign rp_price = section.settings.fallback_price | times: 100 -%}
  {%- endif -%}

  <section
    id="{{ section_id }}"
    class="overflow-hidden"
    style="
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="container-sm">
      <div
        class="rp-calc"
        data-rp
        data-price="{{ rp_price }}"
        data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
        data-locale="{{ request.locale.iso_code | default: 'en-GB' }}"
        data-classes-max="{{ section.settings.classes_max }}"
        data-frequency="{{ section.settings.default_frequency }}"
        data-horizon="{{ section.settings.horizon_months }}"
        style="--rp-accent: {{ section.settings.accent_color }}; --rp-surface: {{ section.settings.surface_color }};"
      >
        <div class="rp-head">
          {% if section.settings.calc_eyebrow != blank %}<p class="rp-eyebrow">{{ section.settings.calc_eyebrow }}</p>{% endif %}
          {% if section.settings.calc_heading != blank %}<h2 class="rp-title heading-03">{{ section.settings.calc_heading }}</h2>{% endif %}
          {% if section.settings.calc_text != blank %}<div class="rp-intro">{{ section.settings.calc_text }}</div>{% endif %}
        </div>

        <div class="rp-grid">
          <div class="rp-inputs">
            <div class="rp-priceline">
              <span class="rp-priceline-k">{{ section.settings.price_label }}</span>
              <span class="rp-priceline-v" data-rp-reformer>{% if rp_price > 0 %}{{ rp_price | money }}{% else %}--{% endif %}</span>
            </div>

            <div class="rp-field">
              <label class="rp-label" for="rp-price-{{ section.id }}">Price per class</label>
              <div class="rp-input">
                <span class="rp-affix" data-rp-price-symbol></span>
                <input id="rp-price-{{ section.id }}" class="rp-num" type="number" inputmode="decimal" data-rp-price
                  min="{{ section.settings.class_price_min }}" max="{{ section.settings.class_price_max }}" step="any"
                  value="{{ section.settings.default_class_price }}" aria-label="Price per class">
              </div>
            </div>

            <div class="rp-field">
              <div class="rp-label-row">
                <label class="rp-label" for="rp-count-{{ section.id }}">Classes per</label>
                <div class="rp-tabs" role="tablist" aria-label="Frequency">
                  <button type="button" class="rp-tab" data-rp-freq="week" aria-pressed="false">week</button>
                  <button type="button" class="rp-tab" data-rp-freq="month" aria-pressed="false">month</button>
                </div>
              </div>
              <div class="rp-input">
                <input id="rp-count-{{ section.id }}" class="rp-num" type="number" inputmode="numeric" data-rp-count
                  min="1" max="{{ section.settings.classes_max }}" step="1"
                  value="{{ section.settings.default_classes }}" aria-label="Number of classes">
                <span class="rp-affix rp-affix--suffix" data-rp-count-label>a month</span>
              </div>
            </div>
          </div>

          <div class="rp-results" aria-live="polite">
            <div class="rp-result-main">
              <span class="rp-result-k">Pays for itself in</span>
              <span class="rp-result-big"><span data-rp-months>--</span> <span class="rp-unit" data-rp-months-unit>months</span></span>
            </div>
            <div class="rp-result-sub">
              then you save <span class="rp-hl" data-rp-saving>--</span> every year after
            </div>

            <div class="rp-bar" aria-hidden="true">
              <div class="rp-bar-fill" data-rp-fill style="width:0%"></div>
              <span class="rp-bar-marker" data-rp-marker style="left:0%"></span>
            </div>
            <div class="rp-bar-legend">
              <span><i class="rp-dot rp-dot--accent"></i> Cost recovered</span>
              <span><i class="rp-dot rp-dot--muted"></i> Saving after</span>
            </div>

            {% if section.settings.cta_label != blank %}
              <a class="rp-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
            {% endif %}

            <p class="rp-disclaimer">{{ section.settings.disclaimer }}</p>
          </div>
        </div>
      </div>
    </div>

    <style>
      #{{ section_id }} .rp-calc { --rp-ink: #111111; --rp-muted: #737373; --rp-line: #e5e5e5; position: relative; margin-bottom: 3.5rem; padding: clamp(1.75rem, 4vw, 3.25rem); border: 1px solid var(--rp-line); border-radius: 1rem; background: var(--rp-surface); color: var(--rp-ink); font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; }
      #{{ section_id }} .rp-eyebrow { margin: 0 0 .9rem; font-size: 12px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: var(--rp-muted); }
      #{{ section_id }} .rp-title { margin: 0; color: var(--rp-ink); }
      #{{ section_id }} .rp-intro { margin: 1rem 0 0; max-width: 48ch; color: var(--rp-muted); font-size: 1.02rem; line-height: 1.6; }
      #{{ section_id }} .rp-intro p { margin: 0; }
      #{{ section_id }} .rp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); margin-top: 2.5rem; align-items: start; }
      #{{ section_id }} .rp-priceline { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-bottom: 1.2rem; margin-bottom: 1.8rem; border-bottom: 1px solid var(--rp-line); }
      #{{ section_id }} .rp-priceline-k { font-size: .95rem; color: var(--rp-muted); }
      #{{ section_id }} .rp-priceline-v { font-weight: 600; font-size: 1.35rem; color: var(--rp-ink); }
      #{{ section_id }} .rp-field { margin-bottom: 1.8rem; }
      #{{ section_id }} .rp-field:last-child { margin-bottom: 0; }
      #{{ section_id }} .rp-label { display: block; font-size: .95rem; color: var(--rp-ink); margin-bottom: .6rem; }
      #{{ section_id }} .rp-label-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .6rem; }
      #{{ section_id }} .rp-label-row .rp-label { margin-bottom: 0; }
      #{{ section_id }} .rp-input { display: flex; align-items: center; gap: .5rem; border: 1px solid var(--rp-line); border-radius: 10px; padding: .35rem .95rem; background: #fff; transition: border-color .15s ease, box-shadow .15s ease; }
      #{{ section_id }} .rp-input:focus-within { border-color: var(--rp-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--rp-accent) 18%, transparent); }
      #{{ section_id }} .rp-affix { color: var(--rp-muted); font-size: 1.05rem; white-space: nowrap; flex-shrink: 0; }
      #{{ section_id }} .rp-affix--suffix { font-size: .95rem; }
      #{{ section_id }} .rp-num { flex: 1 1 auto; width: 100%; border: 0; outline: none; background: transparent; color: var(--rp-ink); font-family: inherit; font-size: 1.35rem; font-weight: 600; padding: .5rem 0; -moz-appearance: textfield; }
      #{{ section_id }} .rp-num::-webkit-outer-spin-button, #{{ section_id }} .rp-num::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
      #{{ section_id }} .rp-tabs { display: inline-flex; gap: .25rem; }
      #{{ section_id }} .rp-tab { font-size: .9rem; padding: .2rem .1rem; margin-left: .8rem; background: transparent; color: var(--rp-muted); border: 0; border-bottom: 2px solid transparent; cursor: pointer; transition: color .15s ease, border-color .15s ease; }
      #{{ section_id }} .rp-tab[aria-pressed="true"] { color: var(--rp-ink); border-bottom-color: var(--rp-accent); }
      #{{ section_id }} .rp-results { border-left: 1px solid var(--rp-line); padding-left: clamp(1.5rem, 4vw, 3rem); }
      #{{ section_id }} .rp-result-k { display: block; font-size: .9rem; color: var(--rp-muted); margin-bottom: .5rem; }
      #{{ section_id }} .rp-result-big { font-family: 'Aktiv Grotesk Ex', 'Arial Narrow', sans-serif; font-weight: 400; letter-spacing: -.01em; font-size: clamp(44px, 8vw, 72px); line-height: 1; color: var(--rp-accent); display: block; }
      #{{ section_id }} .rp-result-big .rp-unit { font-family: 'Inter', sans-serif; font-size: .3em; font-weight: 500; color: var(--rp-ink); letter-spacing: 0; }
      #{{ section_id }} .rp-result-sub { margin-top: 1.1rem; color: var(--rp-ink); font-size: 1.05rem; }
      #{{ section_id }} .rp-hl { font-weight: 600; }
      #{{ section_id }} .rp-bar { position: relative; height: 6px; border-radius: 999px; background: var(--rp-line); margin-top: 1.8rem; }
      #{{ section_id }} .rp-bar-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--rp-accent); border-radius: 999px; transition: width .6s cubic-bezier(.22,.61,.36,1); }
      #{{ section_id }} .rp-bar-marker { position: absolute; top: 50%; width: 12px; height: 12px; border-radius: 50%; background: #fff; border: 2px solid var(--rp-accent); transform: translate(-50%, -50%); transition: left .6s cubic-bezier(.22,.61,.36,1); }
      #{{ section_id }} .rp-bar-legend { display: flex; gap: 1.4rem; margin-top: .9rem; font-size: .8rem; color: var(--rp-muted); flex-wrap: wrap; }
      #{{ section_id }} .rp-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
      #{{ section_id }} .rp-dot--accent { background: var(--rp-accent); }
      #{{ section_id }} .rp-dot--muted { background: var(--rp-line); }
      #{{ section_id }} .rp-cta { display: inline-block; margin-top: 1.8rem; font-size: .95rem; letter-spacing: .01em; text-decoration: none; padding: 13px 28px; border-radius: 10px; background: var(--rp-ink); color: #fff; border: 1px solid var(--rp-ink); transition: opacity .15s ease; }
      #{{ section_id }} .rp-cta:hover { opacity: .85; }
      #{{ section_id }} .rp-disclaimer { margin: 1.4rem 0 0; font-size: .74rem; color: var(--rp-muted); }
      @media (max-width: 749px) {
        #{{ section_id }} .rp-calc { padding: 1.5rem 1.35rem; margin-bottom: 2rem; }
        #{{ section_id }} .rp-intro { margin-top: .7rem; font-size: .97rem; }
        #{{ section_id }} .rp-grid { grid-template-columns: 1fr; gap: 1.6rem; margin-top: 1.6rem; }
        #{{ section_id }} .rp-priceline { padding-bottom: 1rem; margin-bottom: 1.3rem; }
        #{{ section_id }} .rp-field { margin-bottom: 1.3rem; }
        #{{ section_id }} .rp-results { border-left: 0; border-top: 1px solid var(--rp-line); padding-left: 0; padding-top: 1.6rem; }
        #{{ section_id }} .rp-result-big { font-size: 40px; }
        #{{ section_id }} .rp-result-sub { font-size: 1rem; margin-top: .9rem; }
        #{{ section_id }} .rp-bar { margin-top: 1.4rem; }
      }
      @media (prefers-reduced-motion: reduce) { #{{ section_id }} .rp-bar-fill, #{{ section_id }} .rp-bar-marker, #{{ section_id }} .rp-input { transition: none; } }
    </style>
  </section>

  <script>
    (() => {
      const root = document.querySelector('#{{ section_id }} [data-rp]');
      if (!root) return;
      if (root.dataset.rpInit === 'true') return;
      root.dataset.rpInit = 'true';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const priceCents = parseFloat(root.dataset.price) || 0;
      const price = priceCents / 100;
      const currency = root.dataset.currency || 'GBP';
      const locale = root.dataset.locale || 'en-GB';
      const horizon = parseFloat(root.dataset.horizon) || 24;

      const priceInput = root.querySelector('[data-rp-price]');
      const countInput = root.querySelector('[data-rp-count]');
      const priceSymbol = root.querySelector('[data-rp-price-symbol]');
      const countLabel = root.querySelector('[data-rp-count-label]');
      const monthsEl = root.querySelector('[data-rp-months]');
      const monthsUnit = root.querySelector('[data-rp-months-unit]');
      const savingEl = root.querySelector('[data-rp-saving]');
      const fill = root.querySelector('[data-rp-fill]');
      const marker = root.querySelector('[data-rp-marker]');
      const freqBtns = Array.from(root.querySelectorAll('[data-rp-freq]'));
      let freq = root.dataset.frequency === 'week' ? 'week' : 'month';

      const money0 = new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: 0 });

      try {
        const parts = new Intl.NumberFormat(locale, { style: 'currency', currency }).formatToParts(0);
        const sym = parts.find((p) => p.type === 'currency');
        if (priceSymbol && sym) priceSymbol.textContent = sym.value;
      } catch (e) {
        if (priceSymbol) priceSymbol.textContent = currency;
      }

      const anims = new WeakMap();
      function animateNumber(el, to, fmt) {
        if (!el) return;
        const from = anims.get(el) != null ? anims.get(el) : to;
        anims.set(el, to);
        if (reduceMotion || from === to) { el.textContent = fmt(to); return; }
        const start = performance.now();
        const dur = 450;
        function step(now) {
          const t = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = fmt(from + (to - from) * eased);
          if (t < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      function setFreq(next) {
        freq = next;
        freqBtns.forEach((b) => b.setAttribute('aria-pressed', b.dataset.rpFreq === next ? 'true' : 'false'));
        if (countLabel) countLabel.textContent = 'a ' + next;
        compute();
      }

      function compute() {
        const classPrice = parseFloat(priceInput.value) || 0;
        const count = parseFloat(countInput.value) || 0;

        const monthlyClasses = freq === 'week' ? count * 4.345 : count;
        const monthlySpend = classPrice * monthlyClasses;
        const annualSaving = monthlySpend * 12;
        let months = (monthlySpend > 0 && price > 0) ? price / monthlySpend : Infinity;

        if (!isFinite(months) || months <= 0) {
          if (monthsEl) monthsEl.textContent = '--';
          if (savingEl) savingEl.textContent = money0.format(0);
          if (fill) fill.style.width = '0%';
          if (marker) marker.style.left = '0%';
          return;
        }

        const showDecimals = months < 10;
        animateNumber(monthsEl, months, (v) => showDecimals ? (Math.round(v * 10) / 10).toString() : Math.round(v).toString());
        if (monthsUnit) monthsUnit.textContent = (months >= 1 && months < 2) ? 'month' : 'months';
        animateNumber(savingEl, annualSaving, (v) => money0.format(v));

        const pct = Math.max(2, Math.min(100, (months / horizon) * 100));
        if (fill) fill.style.width = pct + '%';
        if (marker) marker.style.left = pct + '%';
      }

      priceInput.addEventListener('input', compute);
      countInput.addEventListener('input', compute);
      freqBtns.forEach((b) => b.addEventListener('click', () => setFreq(b.dataset.rpFreq)));

      [priceInput, countInput].forEach((el) => {
        if (!el) return;
        el.addEventListener('wheel', (e) => { if (document.activeElement === el) e.preventDefault(); }, { passive: false });
      });

      setFreq(freq);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Reformer payback",
  "tag": "section",
  "class": "section section-reformer-payback",
  "settings": [
    { "type": "header", "content": "Payback calculator" },
    { "type": "checkbox", "id": "show_calculator", "label": "Show payback calculator", "default": true },
    { "type": "text", "id": "calc_eyebrow", "label": "Eyebrow", "default": "How it adds up" },
    { "type": "text", "id": "calc_heading", "label": "Heading", "default": "When does it pay for itself?" },
    { "type": "richtext", "id": "calc_text", "label": "Intro text", "default": "<p>Studio sessions add up. Enter what you pay per class and how often you practise, and see how soon your own reformer works out cheaper.</p>" },
    { "type": "text", "id": "price_label", "label": "Price line label", "default": "This reformer" },
    { "type": "number", "id": "fallback_price", "label": "Fallback price", "info": "Used only when the section is not on a product (e.g. theme preview). Whole units, no symbol." },
    { "type": "number", "id": "default_class_price", "label": "Default price per class", "default": 12 },
    { "type": "number", "id": "class_price_min", "label": "Minimum price per class", "default": 1 },
    { "type": "number", "id": "class_price_max", "label": "Maximum price per class", "default": 200 },
    { "type": "number", "id": "default_classes", "label": "Default number of classes", "default": 8 },
    { "type": "number", "id": "classes_max", "label": "Maximum number of classes", "default": 60 },
    { "type": "select", "id": "default_frequency", "label": "Default frequency", "options": [ { "value": "week", "label": "Per week" }, { "value": "month", "label": "Per month" } ], "default": "month" },
    { "type": "range", "id": "horizon_months", "label": "Break-even bar length (months)", "min": 12, "max": 48, "step": 6, "default": 24 },
    { "type": "text", "id": "cta_label", "label": "Button label (optional)" },
    { "type": "url", "id": "cta_link", "label": "Button link (optional)" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Estimate only, based on the numbers you enter. Class prices and frequency vary." },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#111111" },
    { "type": "color", "id": "surface_color", "label": "Panel background", "default": "#f5f5f5" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 0, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 0, "unit": "px" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "default": 0, "unit": "px" },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "default": 0, "unit": "px" }
  ],
  "presets": [ { "name": "Reformer payback" } ]
}
{% endschema %}
