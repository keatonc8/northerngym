{% render 'abu-styles' %}
<div class="abu-scope">
  <div class="abu-container abu-rhythm">
    <div class="abu-row{% if section.settings.image_position == 'left' %} abu-row-rev{% endif %}">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="abu-meta">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="abu-h02" style="margin-top:0.5rem;margin-bottom:1.25rem;">{{ section.settings.heading }}</h2>
        <div class="abu-prose">{{ section.settings.body }}</div>
      </div>
      <div>
        <div class="abu-media abu-tall">
          {% if section.settings.image %}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 1024px) 50vw, 100vw' }}
          {% else %}
            {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Block - About Mission",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Our Mission" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make fitness easier, so people can work harder." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Fitness shouldn't be complicated. Too often it's buried beneath trends, gimmicks, and unnecessary noise. Our mission is to simplify fitness, making it easier for more people to train with confidence and consistency.</p><p>We do that by building high-quality gym equipment, creating honest educational content, and delivering customer service that genuinely supports our community.</p><p>We take care of the details so our customers can focus on what matters most: putting in the work.</p>"
    },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    }
  ],
  "presets": [
    { "name": "Block - About Mission" }
  ]
}
{% endschema %}
