{% assign background_image = section.settings.background_image %}
{% assign background_image_mobile = section.settings.background_image_mobile %}
{% assign background_video = section.settings.background_video %}
{% assign background_video_mobile = section.settings.background_video_mobile %}
{% assign has_mobile_background = false %}
{% if background_image_mobile != blank or background_video_mobile != blank %}
   {% assign has_mobile_background = true %}
{% endif %}
{% assign has_desktop_background = false %}
{% if background_image != blank or background_video != blank %}
   {% assign has_desktop_background = true %}
{% endif %}
{% assign desktop_background_alignment = section.settings.desktop_background_alignment | default: 'object-center' %}
{% assign mobile_background_alignment = section.settings.mobile_background_alignment | default: 'object-center' %}
{% assign heading = section.settings.heading %}
{% assign paragraph = section.settings.paragraph %}
{% assign button_one_link = section.settings.button_one_link %}
{% assign button_one_text = section.settings.button_one_text | default: 'Click Here' %}
{% assign button_two_link = section.settings.button_two_link %}
{% assign button_two_text = section.settings.button_two_text | default: 'Click Here' %}
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
/>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"
/>
<style>
  .usp-slick-slider .slick-track {
    display: flex;
  }

  .usp-slick-slide {
    height: auto;
  }
  
  .usp-slick-slider {
    opacity: 0;
    visibility: hidden;
  }

  .usp-slick-slider.slick-initialized {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease;
  }
 .usp-slick-slider {
    max-height: 23px; /* adjust to your USP height */
  }
</style>

<div class="container-full">
   {% if section.blocks != blank %}
      <div class="bg-black text-white py-3">
         <div class="md:container">
            <div
  class="usp-slick-slider"
  data-section-id="{{ section.id }}"
>
  {% for usp_item in section.blocks %}
    <div class="usp-slick-slide">
      <div class="container flex justify-center">
        {% render 'homepage-banner-usp-item', usp_item: usp_item %}
      </div>
    </div>
  {% endfor %}
</div>

            {% comment %} <div class="hidden md:flex md:gap-12 md:justify-between">
               {% for usp_item in section.blocks %}
                  {% render 'homepage-banner-usp-item', usp_item: usp_item %}
               {% endfor %}
            </div>
            <div class="glide md:hidden" data-module="homepage-banner-usps">
               <div class="glide__track" data-glide-el="track">
                  <ul class="glide__slides">
                     {% for usp_item in section.blocks %}
                        <li class="glide__slide">
                           <div class="container flex justify-center">
                              {% render 'homepage-banner-usp-item', usp_item: usp_item %}
                           </div>
                        </li>
                     {% endfor %}
                  </ul>
               </div>
            </div> {% endcomment %}
         </div>
      </div>
   {% endif %}
   <div class="bg-black text-white py-10 relative min-h-180 md:min-h-150 grid">
      {% if has_mobile_background or has_desktop_background %}
         <div class="absolute w-full h-full inset-0 z-0">
            {% if has_desktop_background == true %}
               <div class="{% if has_mobile_background == true %}hidden md:block{% endif %}">
                  {% if background_video != blank %}
                     <div class="homepage-banner__video homepage-banner__video--desktop {{ desktop_background_alignment }}">
                        {{ background_video | video_tag: image_size: '1100x', autoplay: true, loop: true, controls: false, muted: true }}
                     </div>
                  {% else %} 
                     {% if background_image != blank %}
                        {% assign background_image_classes = 'object-cover w-full h-full absolute inset-0 ' | append: desktop_background_alignment %}
                        {% render 'responsive-image',
                           image_object: background_image,
                           size: 'full',
                           class: background_image_classes
                        %}
                     {% endif %}
                  {% endif %}
               </div>
            {% endif %}
            {% if has_mobile_background == true %}
               <div class="{% if has_desktop_background == true %}md:hidden{% endif %}">
                  {% if background_video_mobile != blank %}
                     <div class="homepage-banner__video homepage-banner__video--mobile {{ mobile_background_alignment }}">
                        {{ background_video_mobile | video_tag: image_size: '1100x', autoplay: true, loop: true, controls: false, muted: true }}
                     </div>
                  {% else %} 
                     {% if background_image_mobile != blank %}
                        {% assign background_image_mobile_classes = 'object-cover w-full h-full absolute inset-0 ' | append: mobile_background_alignment %}
                        {% render 'responsive-image',
                           image_object: background_image_mobile,
                           size: 'full',
                           class: background_image_mobile_classes
                        %}
                     {% endif %}
                  {% endif %}
               </div>
            {% endif %}
         </div>
      {% endif %}
      <div class="container h-full relative z-1">
         <div class="flex justify-start items-end h-full">
            <div class="flex flex-col gap-8 w-full">
               {% if heading != blank or paragraph != blank %}
                  <div class="flex flex-col gap-4 lg:gap-8 lg:max-w-110">
                     {% if heading != blank %}
                        <h1 class="heading-01">
                           {{ heading }}
                        </h1>
                     {% endif %}
                     {% if paragraph != blank %}
                        <p>
                           {{ paragraph }}
                        </p>
                     {% endif %}
                  </div>
               {% endif %}
               {% if button_one_link != blank or button_two_link != blank %}
                  <div class="flex flex-col sm:flex-row gap-4">
                     {% if button_one_link != blank %}
                        <a href="{{ button_one_link }}" class="button button-yellow-alt">
                           {{ button_one_text }}
                        </a>
                     {% endif %}
                     {% if button_two_link != blank %}
                        <a href="{{ button_two_link }}" class="button button-white button-transparent">
                           {{ button_two_text }}
                        </a>
                     {% endif %}
                  </div>
               {% endif %}
            </div>
         </div>
      </div>
   </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script>
  (function () {
    function initUSPSlick() {
      var $slider = $('.usp-slick-slider[data-section-id="{{ section.id }}"]');

      if (!$slider.length || $slider.hasClass('slick-initialized')) return;

      $slider.on('init', function () {
        $slider.addClass('slick-initialized');
      });

      $slider.slick({
        slidesToShow: 3,
        slidesToScroll: 1,
        arrows: false,
        dots: false,
        infinite: true,
        adaptiveHeight: true,

        autoplay: true,
        autoplaySpeed: 3000,
        speed: 600,
        pauseOnHover: true,
        pauseOnFocus: false,

        responsive: [
         {
            breakpoint: 1200,
            settings: {
              slidesToShow: 2      // 768–1199px
            }
          },
          {
            breakpoint: 768,
            settings: {
              slidesToShow: 1      // ≤ 767px
            }
          }
        ]
      });
    }

    document.addEventListener('DOMContentLoaded', initUSPSlick);
    document.addEventListener('shopify:section:load', initUSPSlick);
  })();
</script>



