          "settings": {
            "number": "",
            "image": "shopify://shop_images/484159124.jpg",
            "title": "",
            "text": "<p>My focus is on the older community, strength and conditioning is more important than ever, with over 50's classes, Chair Aerobics and Women's only strengthening session, building that community location, where people can come together, work out and talk to each other.<br/><br/></p>",
            "button_label": "",
            "button_link": ""
          }
