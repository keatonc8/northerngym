<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
   <head>
<!-- Start of Shoplift scripts -->
{% render 'shoplift' %}
<!-- End of Shoplift scripts -->

        <script
src="https://www.paypal.com/sdk/js?client-id=AYeWmNlkeON1p6tsjeC1HUOuFpAHLx5c5U3BEJE_I4ni5YDgnkuHieWgdrytp682ze2-rOH1s_m_feUL&currency=GBP&components=messages"
data-namespace="PayPalSDK">
</script>
{% render 'visually_io_sdk' %} 

      <meta charset="utf-8">
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <meta name="theme-color" content="">
      <link rel="canonical" href="{{ canonical_url }}">
      <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

      <link rel="icon" type="image/png" href="{{ 'favicon-96x96.png' | asset_img_url: '96x96' }}" sizes="96x96" />
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}" />
      <link rel="shortcut icon" href="{{ 'favicon.ico' | asset_url }}" />
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_img_url: '180x180' }}" />
      <meta name="apple-mobile-web-app-title" content="Northern" />
      <link rel="manifest" href="{{ 'site.webmanifest' | asset_url }}" />

      <title>
         {{ page_title }}
         {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
         {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
         {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      </title>

      {% if page_description %}
         <meta name="description" content="{{ page_description | escape }}">
      {% endif %}

      <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
      <script src="{{ 'custom.js' | asset_url }}" defer></script>
      <script src="{{ 'timer.js' | asset_url }}" defer></script>


      {%- render 'swish' -%}
      
      {{ content_for_header }}
      {{ 'fonts.css' | asset_url | stylesheet_tag }}

      <!-- Custom Styles -->
      <link href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.css" rel="stylesheet" />
      {{ 'custom.css' | asset_url | stylesheet_tag }}

      <script>
         document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
         if (Shopify.designMode) {
            document.documentElement.classList.add('shopify-design-mode');
         }
      </script>

      {% case template.name %}
         {% when 'product' %}
         {% comment %}{{ 'option_selection.js' | shopify_asset_url | script_tag }}{% endcomment %}
      {% endcase %}    

      <script>
  (function () {
    document.addEventListener('DOMContentLoaded', () => {
      document.oncontextmenu = null;
      document.onselectstart = null;
    });
    const kill = (e) => { e.stopImmediatePropagation(); };
    ['contextmenu', 'selectstart', 'copy', 'cut'].forEach(type => {
      window.addEventListener(type, kill, true);
      document.addEventListener(type, kill, true);
    });
  })();
</script>

   

{% render 'abconvert-checkout-ui-test' %}


</head>

   <body class="body {{ template.name }} --{{ template.name }}"
      x-init="$el.classList.add('alpine-loaded')"
      x-data="{
         showCartDrawer: false,
         modalOverlay: false,
         showSearch: false,
         showMenu: false,
         cartItemCount: {{ cart.item_count | default: 0 }},
         updateCartCount() {
            fetch('/cart.js')
               .then(res => res.json())
               .then(data => { this.cartItemCount = data.item_count; })
               .catch(err => console.error('Cart count fetch error:', err));
         }
      }"
      @toggle-cart.window="showCartDrawer = !showCartDrawer"
      @toggle-menu.window="showMenu = !showMenu;"
      @cart-updated.window="updateCartCount()"
      :class="(showCartDrawer || modalOverlay || showMenu) ? 'overflow-hidden' : 'overflow-auto'"
   >
      <a class="sr-only" href="#MainContent">
         {{ "accessibility.skip_to_text" | t }}
      </a>

      {% section 'header' %}

      {%- comment -%} CUSTOM CODE - BOGOHP ANNOUNCEMENT TICKER {%- endcomment -%}
      {% section 'announcement-ticker' %}

      {%- comment -%} CUSTOM CODE - BOGOHP COUNTDOWN RIBBON (toggle in section settings) {%- endcomment -%}
      {% section 'countdown-ribbon-bogohp' %}


      {% render 'cart-drawer' %}

      <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
         <div class="{{ main_classes }}">
            {{ content_for_layout }}
         </div>

         {%- comment -%}TODO: Remove when colours are set up for the site{%- endcomment -%}
         {% if settings.show_build_kit %}
            {% section 'temp-containers' %}
            {% section 'temp-colours' %}
            {% section 'temp-type' %}
            {% section 'temp-buttons' %}
            {% section 'temp-icons' %}
            {% section 'temp-prose' %}
         {% endif %}
      </main>

      {% section 'footer' %}

      <ul hidden>
         <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      </ul>

      <script>
         window.shopUrl = '{{ request.origin }}';
         window.routes = {
            cart_add_url: '{{ routes.cart_add_url }}',
            cart_change_url: '{{ routes.cart_change_url }}',
            cart_update_url: '{{ routes.cart_update_url }}',
            predictive_search_url: '{{ routes.predictive_search_url }}'
         };
         window.cartStrings = {
            error: `{{ 'sections.cart.cart_error' | t }}`,
            quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
         }
         window.variantStrings = {
            addToCart: `{{ 'products.product.add_to_cart' | t }}`,
            soldOut: `{{ 'products.product.sold_out' | t }}`,
            unavailable: `{{ 'products.product.unavailable' | t }}`,
         }
         window.accessibilityStrings = {
            imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
            shareSuccess: `{{ 'general.share.success_message' | t }}`,
            pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
            playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
         }
      </script>
      <style>
   .card-wrap, .offer-wrap { position: relative; }
   .custom-offer {
    position: absolute; z-index: 49; top: -32px !important;
    padding: 0 20px; background: #ffc30b; width: 100%;
    text-align: center; font-size: 13px; color: #212121;
    bottom: unset; height: fit-content;
   }
   .search .custom-offer { font-size: 10px; }
   @media only screen and (max-width: 600px) {
     .custom-offer { padding: 0 !important; font-size: 11px; top: -30px !important; }
     .cst-product-content { padding-bottom: 0; }
   }
   /* Mobile product gallery: natural fit - each image full width, true shape, auto height (NGE) */
   @media only screen and (max-width: 767px) {
     [data-carousel-type="product-images"] .glide__slide .aspect-\[8\/9\] { aspect-ratio: auto; height: auto; }
     [data-carousel-type="product-images"] .glide__slide img { object-fit: contain; height: auto; width: 100%; }
   }
      </style>
   </body>
</html>
