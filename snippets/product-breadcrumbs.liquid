{% comment %}
  Tailwind Breadcrumbs for Product Page
{% endcomment %}

<nav class=" text-xs uppercase py-2 px-4" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1 text-gray-500"
      itemscope
      itemtype="https://schema.org/BreadcrumbList">

    <!-- Home -->
    <li class="flex items-center"
        itemprop="itemListElement"
        itemscope
        itemtype="https://schema.org/ListItem">
      <a itemprop="item"
         href="{{ routes.root_url }}"
         class="hover:text-neutral-800 text-neutral-400">
        <span itemprop="name">Home</span>
      </a>
      <meta itemprop="position" content="1" />
    </li>
    <span class="mx-2 text-gray-400">/</span>

    {% assign position = 2 %}

    {% if collection %}
      <!-- Collection from URL -->
      <li class="flex items-center"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem">
        <a itemprop="item"
           href="{{ collection.url }}"
           class="hover:text-neutral-800 text-neutral-400">
          <span itemprop="name">{{ collection.title }}</span>
        </a>
        <meta itemprop="position" content="{{ position }}" />
      </li>
      <span class="mx-2 text-gray-400">/</span>
      {% assign position = position | plus: 1 %}
    {% elsif product.collections.first %}
      <!-- Fallback Collection -->
      <li class="flex items-center"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem">
        <a itemprop="item"
           href="{{ product.collections.first.url }}"
           class="hover:text-neutral-800 text-neutral-400">
          <span itemprop="name">{{ product.collections.first.title }}</span>
        </a>
        <meta itemprop="position" content="{{ position }}" />
      </li>
      <span class="mx-2 text-gray-400 hidden lg:inline">/</span>
      {% assign position = position | plus: 1 %}
    {% endif %}

    <!-- Product -->
    <li class="text-neutral-800 font-medium hidden lg:inline"
        itemprop="itemListElement"
        itemscope
        itemtype="https://schema.org/ListItem">
      <span itemprop="name">{{ product.title }}</span>
      <meta itemprop="item" content="{{ product.url }}" />
      <meta itemprop="position" content="{{ position }}" />
    </li>

  </ol>
</nav>