<div class="flex gap-5 border-b xs:border-0 border-silver pb-3 xs:pb-0">
   <a href="{{ item.product.url }}" class="w-1/4 md:w-1/5 overflow-hidden group">
      <div class="aspect-w-2 aspect-h-3">
         {% render 'responsive-image',
            image_object: item.image,
            size: 'mobile',
            class: 'group-hover:scale-105 duration-300'
         %}
      </div>
   </a>
   <div class="w-3/4 md:w-4/5 flex flex-col gap-10">
      <div class="flex flex-col gap-1">
         <a href="{{ item.product.url }}" class="hover:text-yellow">
            {{ item.product.title }}
         </a>
         {% unless item.variant.title == 'Default Title' %}
            <p class="body-03">
               {{ item.variant.title | downcase | capitalize }}
            </p>
         {% endunless %}
      </div>
      <div class="flex flex-col xs:flex-row xs:justify-between gap-y-4 gap-x-10 xs:items-center">
         <div class="flex justify-between xs:justify-start gap-8 flex-auto items-center">
            <div class="product-qty__wrapper product-qty__wrapper--small w-auto m-0" 
               x-data="{ 
                  qty: {{item.quantity}},
                  minus(value) {
                     this.qty = parseInt(this.qty);
                     (this.qty == 1) ? this.qty = 1 : this.qty -= value;
                  },
                  plus(value) {
                     this.qty = parseInt(this.qty);
                     this.qty += value;
                  }
               }"
               x-init="$watch('qty', value => { loading = true; Main.updateQuantity({{ forloop_index }}, qty) });"
            >  
               <button type="button" class="" @click="minus(1)">
                  <span class="sr-only">
                     {{ 'products.product.quantity.decrease' | t: product: product.title | escape }}
                  </span>
                  {% render 'icons', icon: 'minus', class: 'w-3.5' %}
               </button>
         
               <input type="number" x-model="qty" name="quantity" class="product-qty__input pt-1" value="1" min="1" max="9999">
         
               <button type="button" class="" @click="plus(1)">
                  <span class="sr-only">
                     {{ 'products.product.quantity.increase' | t: product: product.title | escape }}
                  </span>
                  {% render 'icons', icon: 'plus', class: 'w-3.5' %}
               </button>
            </div>
            <div class="text-grey">
               {% render 'remove-button', title: item.product.title, index: forloop_index %}
            </div>
            {% if false %}
               <a href="#" class="link hidden sm:block">
                  Add To Wishlist
               </a>
            {% endif %}
         </div>
         <p class="body-01 font-bold flex-none">
            {{ item.line_price | money }}
         </p>
      </div>
   </div>
</div>