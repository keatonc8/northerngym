<div class="hidden xs:flex {% if hide_on_desktop %}xl:hidden{% endif %} absolute right-0 bottom-full {% if no_heading %}mb-4{% else %}mb-6{% endif %} md:mb-6 mr-4 md:mr-8 lg:mr-12 xl:mr-0 gap-5" data-glide-el="controls">
   <button class="carousel__arrow--northern" data-glide-dir="<">
      <span class="block -rotate-90">
         {% render 'icons', icon: 'arrow-northern', class: 'w-6' %}
      </span>
      <span class="sr-only">
         Previous
      </span>
   </button>
   <button class="carousel__arrow--northern" data-glide-dir=">">
      <span class="block rotate-90">
         {% render 'icons', icon: 'arrow-northern', class: 'w-6' %}
      </span>
      <span class="sr-only">
         Next
      </span>
   </button>
</div>