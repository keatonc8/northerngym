{% assign item_count = 0 %}
{% if section_blocks != blank %}
   {% for block in section_blocks %}
      {% assign item_count = item_count | plus: 1 %}
   {% endfor %}
{% else %}
   {% for item in carousel_items %}
      {% assign item_count = item_count | plus: 1 %}
   {% endfor %}
{% endif %}

{% if item_count == 1 %}
   <div class="container">
      {% if section_blocks != blank %}
         {% for block in section_blocks %}
            {% render 'image-carousel-item',
               main_image: block.settings.main_image
            %}
         {% endfor %}
      {% else %}
         {% for item in carousel_items %}
            {% render 'image-carousel-item',
               main_image: item
            %}
         {% endfor %}
      {% endif %}
   </div>
{% else %}
   <div class="xl:px-19">
      <div class="glide" data-module="image-carousel">
         <div class="glide__track" data-glide-el="track">
            <ul class="glide__slides">
               {% if section_blocks != blank %}
                  {% for block in section_blocks %}
                     <li class="glide__slide">
                        {% render 'image-carousel-item',
                           main_image: block.settings.main_image
                        %}
                     </li>
                  {% endfor %}
               {% else %}
                  {% for item in carousel_items %}
                     <li class="glide__slide">
                        {% render 'image-carousel-item',
                           main_image: item
                        %}
                     </li>
                  {% endfor %}
               {% endif %}
            </ul>
         </div>
         <div class="glide__arrows" data-glide-el="controls">
            <button class="carousel__arrow--northern carousel__arrow--overlay-position carousel__arrow--left" data-glide-dir="<">
               <span class="block -rotate-90">
                  {% render 'icons', icon: 'arrow-northern', class: 'w-8' %}
               </span>
               <span class="sr-only">
                  Previous
               </span>
            </button>
            <button class="carousel__arrow--northern carousel__arrow--overlay-position carousel__arrow--right" data-glide-dir=">">
               <span class="block rotate-90">
                  {% render 'icons', icon: 'arrow-northern', class: 'w-8' %}
               </span>
               <span class="sr-only">
                  Next
               </span>
            </button>
         </div>
      </div>
   </div>
{% endif %}