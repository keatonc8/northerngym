{% assign blog_link = blog_item.url %}
{% assign blog_title = blog_item.title %}
{% assign blog_handle = blog_item.metafields.northerngym.ambassador_instagram_handle %}
{% assign blog_image = blog_item.image %}

<a href="{{ blog_link }}" class="flex text-white hover:text-yellow group">
   <div class="aspect-w-3 aspect-h-4 overflow-hidden w-full">
      {% if blog_image %}
         {% render 'responsive-image',
            image_object: blog_image,
            size: 'half',
            class: 'group-hover:scale-105 duration-300'
         %}
      {% else %}
         {% render 'image-fallback' %}
      {% endif %}
      <div class="flex justify-start items-end p-5">
         <div class="flex flex-col gap-1">
            <p class="heading-04">
               {{ blog_title }}
            </p>
            <p class="body-03 font-bold">
               {{ blog_handle }}
            </p>
         </div>
      </div>
   </div>
</a>