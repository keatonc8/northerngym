{% assign use_selected_value = use_selected_value | default: false %}

{% assign product_title = product_item.title %}
{% assign product_link = product_item.url %}
{% assign product_image = product_item.featured_image %}

{% if use_selected_value == true %}
   {% assign product_price = product_item.selected_or_first_available_variant.price %}
   {% assign product_price_compare = product_item.selected_or_first_available_variant.compare_at_price %}
{% else %}
   {% assign product_price = product_item.price_min %}
   {% assign product_price_compare = product_item.compare_at_price_min %}
{% endif %}

{% assign product_price = product_price | default: 0 %}
{% assign product_price_compare = product_price_compare | default: 0 %}
{% assign product_card_usps = product_item.metafields.custom.product_card_usps.value %}

{% assign is_on_sale = false %}
{% assign product_variant_count = product_item.variants | size %}
{% for product_variant in product_item.variants %}
   {% if product_variant.compare_at_price > product_variant.price %}
      {% assign is_on_sale = true %}
      {% break %}
   {% endif %}
{% endfor %}

{%- comment -%}
   Does this card show a 'From' price? Passed to the BUNDLE20 flash so the
   discounted figure underneath reads 'From £x' too, rather than implying a
   single fixed price.
{%- endcomment -%}
{%- assign b20_card_is_range = false -%}
{%- if product_item.price_min < product_item.price_max and use_selected_value == false -%}
   {%- assign b20_card_is_range = true -%}
{%- endif -%}

{% assign xRef = 'product_form_' | append: index %}

<div class="flex flex-col gap-4 h-full text-left"
   {% if show_buy_button %}
      x-data="{ 
         qty: 1,
         addToCart(){
            let formData = new FormData($refs.{{ xRef }});
            fetch('/cart/add.js', {
               method: 'POST',
               body: formData
            })
            .then(response => {
               return response.json();
            })
            .then(response => {
               this.$dispatch('cart-updated');
               this.$dispatch('toggle-cart');
            })
            .catch((error) => {
               console.error('Error:', error);
            });
         }
      }"
      @quantity-changed.window="qty = $event.detail.quantity"
   {% endif %}
>
   <a href="{{ product_link }}" class="group flex flex-col h-full gap-3 card-wrap">

      
      <div class="relative aspect-w-2 aspect-h-3 bg-silver overflow-hidden offer-wrap rounded-3xl">

         {% if section.settings.enable_overlay %}
            <div class="absolute top-0 left-0 w-full h-full z-10 bg-gradient-to-b from-black/40 to-transparent"></div>
         {% endif %}
         
         {% render 'responsive-image',
            image_object: product_image,
            size: 'half',
            class: 'group-hover:scale-105 duration-300'
         %}

         {% if false %}{% comment %}WISHLIST REMOVAL{% endcomment %}
            <div class="relative pointer-events-none z-20">
               {% render 'product-like-button', class: 'absolute top-3 right-3' %}
            </div>
         {% endif %}

         {%- render 'swish', component: 'save', context: 'product-card' -%}

         {% if show_tags %}
            <div class="absolute top-3 !left-3 pointer-events-none flex gap-3 items-start z-20">
               {% render 'product-badges', product: product_item %}
            </div>

            {% if product_item.metafields.custom.product_tags != blank %}
               <div class="product-tags flex-col items-end gap-2 absolute top-3 right-3 pr-2 z-20 hidden lg:flex">
                  {% for tag in product_item.metafields.custom.product_tags.value %}
                    <span class="inline-flex items-center gap-2 rounded-full bg-black/30 px-5 py-2 text-sm font-normal text-white/90 ring-1 ring-white/40 backdrop-blur-md">{{ tag }}</span>
                  {% endfor %}
               </div>
            {% endif %}
         {% endif %}

         {% if product_item.metafields.custom.selling_fast_tag != blank %}
            <div class="inline-flex items-center gap-1.5 sm:gap-2 absolute mt-auto p-2 sm:p-3 h-max w-full z-20">
  <div class="inline-flex gap-1.5 sm:gap-2 items-center w-full rounded-2xl bg-black/30 
    px-2 py-2 sm:px-3 sm:py-3 
    text-[11px] sm:text-xs md:text-sm 
    font-normal text-white/90 ring-1 ring-white/40 backdrop-blur-md">

    <span class="w-4 h-4 sm:w-5 sm:h-5 hidden lg:block">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.368 22">
        <path fill="currentColor" d="M2.093 22a2.02 2.02 0 0 1-1.485-.608A2.02 2.02 0 0 1 0 19.907V6.725A2.02 2.02 0 0 1 .608 5.24a2.02 2.02 0 0 1 1.485-.608h2.249v-.29a4.185 4.185 0 0 1 1.271-3.071A4.185 4.185 0 0 1 8.684 0a4.184 4.184 0 0 1 3.071 1.271 4.185 4.185 0 0 1 1.271 3.071v.29h2.249a2.02 2.02 0 0 1 1.485.608 2.02 2.02 0 0 1 .608 1.485v13.182a2.02 2.02 0 0 1-.608 1.485 2.02 2.02 0 0 1-1.485.608Zm0-1.737h13.182a.34.34 0 0 0 .245-.111.34.34 0 0 0 .111-.245V6.725a.34.34 0 0 0-.111-.245.34.34 0 0 0-.245-.111h-2.249v2.605a.84.84 0 0 1-.25.619.84.84 0 0 1-.619.249.84.84 0 0 1-.619-.249.84.84 0 0 1-.25-.619V6.369H6.077v2.605a.84.84 0 0 1-.25.619.84.84 0 0 1-.619.249.84.84 0 0 1-.619-.249.84.84 0 0 1-.25-.619V6.369H2.09a.34.34 0 0 0-.245.111.34.34 0 0 0-.111.245v13.182a.34.34 0 0 0 .111.245.34.34 0 0 0 .248.111ZM6.079 4.632h5.211v-.29a2.514 2.514 0 0 0-.758-1.847 2.513 2.513 0 0 0-1.847-.758 2.514 2.514 0 0 0-1.847.758 2.514 2.514 0 0 0-.758 1.847ZM1.737 20.263Z"></path>
      </svg>
    </span>

    <span class="inline-flex flex-col leading-tight">
      <span class="font-semibold">Selling Fast</span>
      <span>{{ product_item.metafields.custom.selling_fast_tag.value }}</span>
    </span>

  </div>
</div>
         {% endif %}
      </div>
      
      <div class="flex justify-between h-full gap-8 offer-wrap">
         {% comment %} {% unless product_item.tags contains 'outlet' %}
          <div class="custom-offer"><b class="SS">3FOR2 ON EVERYTHING!</b></div>
          {% endunless %} {% endcomment %}

         <div class="flex flex-col gap-2 h-full w-full justify-between">
            {% if product_item.metafields.judgeme.badge != blank %}
               <!-- Start of Judge.me code -->
               <div style="transform: scale(0.75); transform-origin: left center; margin-bottom: -4px;" class="jdgm-widget jdgm-preview-badge" data-id="{{ product_item.id }}" data-auto-install="false">
                  {{ product_item.metafields.judgeme.badge }}
               </div>
               <!-- End of Judge.me code -->
            {% endif %}
            <p class="group-hover:text-yellow duration-300">
               {{ product_title }}
            </p>

            {%- comment -%}
               Price and the BUNDLE20 flash are wrapped together in a flex-col so
               the parent justify-between still sees exactly three children.
               Adding the flash as a fourth direct child would redistribute the
               card's vertical spacing on bundle pages only.
            {%- endcomment -%}
            <div class="flex flex-col gap-1">
               <div class="font-bold flex gap-2 items-center">
                  <p>
                     {% if product_item.price_min < product_item.price_max and use_selected_value == false %}
                        <span>From&nbsp;</span>
                     {% endif %}
                     {{ product_price | money }}
                  </p>

                  {% if product_item.price_min < product_item.price_max and use_selected_value == false %}
                     {%- comment -%} ranged price card: don't show "was" price {%- endcomment -%}
                  {% else %}
                     {% if product_price_compare > product_price %}
                        <p class="text-red line-through">
                           {{ product_price_compare | money }}
                        </p>
                     {% endif %}
                  {% endif %}
               </div>

               {%- render 'bundle20-flash',
                  b20_context: 'card',
                  b20_product: product_item,
                  b20_price: product_price,
                  b20_on_sale: is_on_sale,
                  b20_is_range: b20_card_is_range
               -%}
            </div>
         </div>
         

      </div>
      {% if product_card_usps != blank %}
               <div class="flex flex-col flex-wrap gap-1 border-y border-[#e5e5e5] py-1 text-xs text-[#7a7a7a] w-full">
                  {% for product_card_usp in product_card_usps %}
                     {% assign product_card_usp_text = product_card_usp.text.value %}
                     {% assign product_card_usp_icon = product_card_usp.icon.value %}

                     {% if product_card_usp_text != blank %}
                        <div class="flex items-center gap-2">
                           {% if product_card_usp_icon != blank %}
                              <span class="flex h-5 w-5 shrink-0 items-center justify-center">
                                 {{ product_card_usp_icon | image_url: width: 32 | image_tag: class: 'h-4 w-4 object-contain', loading: 'lazy' }}
                              </span>
                           {% endif %}
                           <span class="leading-tight">{{ product_card_usp_text }}</span>
                        </div>
                     {% endif %}
                  {% endfor %}
               </div>
            {% endif %}
   </a>


   <div class="hidden lg:block">
     <a href="{{ product_link }}" class="inline-flex items-center justify-center rounded-full bg-neutral-100 px-6 py-3 text-base font-medium w-full">
         View Product Details
      </a> 
   </div>

   {% if show_buy_button %}
      <div>
         {% assign product = product_item %}
         {%- form 'product', product, id: product_form_id, class: 'form w-full', novalidate: 'novalidate', x-ref: xRef -%}
            <input type="hidden" name="id" value="{{ product_item.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" x-model="qty" value="1">
            <button class="button button-black button-transparent mb-2"
               name="add"
               @click.prevent="addToCart()"
               {%- unless product_item.selected_or_first_available_variant.available -%}disabled{%- endunless -%}
            >
               {%- unless product_item.selected_or_first_available_variant.available -%}
                  Sold Out
               {%- else -%}
                  Add to Cart
               {%- endunless -%}
            </button>
         {%- endform -%}
      </div>
   {% endif %}
</div>
