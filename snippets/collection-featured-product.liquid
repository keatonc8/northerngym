{% assign product_title = featured_product.title %}
{% assign product_link = featured_product.url %}
{% assign product_image = featured_product.featured_image %}
{% assign product_price = featured_product.selected_or_first_available_variant.price %}
{% assign product_price_compare = featured_product.selected_or_first_available_variant.compare_at_price %}

<div class="bg-black text-white p-5 flex flex-col-reverse sm:flex-row justify-between gap-x-12 gap-y-5 my-6">
   <div class="flex flex-col justify-between gap-12 md:max-w-108 xl:p-3">
      <p class="heading-04">
         Featured Product
      </p>
      <div class="flex flex-col gap-5">
         <div class="flex justify-between gap-6 mb-2">
            <a href="{{ product_link }}" class="hover:text-yellow body-01 xl:text-24 max-w-[75%] xl:max-w-none">
               {{ product_title }}
            </a>
            <div class="flex gap-1 flex-none">
               <span>
                  {% render 'icons', icon: 'star', class: 'w-4 xl:w-6' %}
               </span>
               <span class="xl:text-24">
                  5
               </span>
            </div>
         </div>
         <div class="font-bold flex gap-2 body-01 xl:text-24">
            <p>
               {{ product_price | money }}
            </p>
            {% if product_price_compare > product_price %}
               <p class="text-red line-through">
                  {{ product_price_compare | money }}
               </p>
            {% endif %}
         </div>
         <a href="{{ product_link }}" class="button button-yellow-alt md:mr-auto">
            View Product
         </a>
      </div>
   </div>
   <a href="{{ product_link }}" class="group w-full md:max-w-108">
      <div class="aspect-w-1 aspect-h-1 overflow-hidden">
         {% render 'responsive-image',
            image_object: product_image,
            size: 'half',
            class: 'group-hover:scale-105 duration-300'
         %}
      </div>
   </a>
</div>