{% assign placeholder_default = 'general.search.search' | t %}
{% assign placeholder_text = search_placeholder | default: placeholder_default %}

<form x-data="{ search: '{{ search.terms | escape }}' }" action="{{ routes.search_url }}" method="get" role="search" class="w-full md:max-w-118 relative">
   <input class="w-full border border-silver rounded-full py-3 pl-12 pr-5 placeholder:opacity-60"
      type="search"
      id="nav-search-input"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ placeholder_text }}"
      x-model="search"
   >
   <label class="sr-only" for="nav-search-input">{{ placeholder_default }}</label>
   <input name="options[prefix]" type="hidden" value="last">
   <input type="hidden" name="type" value="product,article">
   <span class="absolute left-4 top-1/2 -translate-y-1/2">
      {% render 'icons', icon: 'search', class: 'w-5' %}
   </span>
   <button type="submit" class="sr-only" aria-hidden="true" tabindex="-1">Submit</button>
</form>