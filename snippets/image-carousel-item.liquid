<div class="aspect-w-3 aspect-h-4 sm:aspect-w-16 sm:aspect-h-9 bg-silver">
   {% if main_image != blank %}
      {% render 'responsive-image',
         image_object: main_image,
         size: 'full',
         class: ''
      %}
   {% else %}
      {% render 'image-fallback' %}
   {% endif %}
</div>