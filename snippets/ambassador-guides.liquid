{% if heading != blank or paragraph != blank or section_blocks != blank or article_handles != blank %}
   <div class="vertical-spacing">
      <div class="container-sm">
         <div class="flex flex-col gap-8 bg-black text-white py-10 px-8">
            {% if heading != blank or paragraph != blank %}
               <div class="flex flex-col gap-4">
                  <h2 class="heading-04">
                     {{ heading }}
                  </h2>
                  <p>
                     {{ paragraph }}
                  </p>
               </div>
            {% endif %}
            {% if section_blocks != blank or article_handles != blank %}
               <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-4 gap-y-8">
                  {% if section_blocks != blank %}
                     {% for block in section_blocks %}
                        {% render 'excercise-guide-item', block: block, index: forloop.index %}
                     {% endfor %}
                  {% else %}
                     {% for article_handle in article_handles %}
                        {% render 'excercise-guide-item', article_handle: article_handle, index: forloop.index %}
                     {% endfor %}
                  {% endif %}
               </div>
            {% endif %}
         </div>
      </div>
   </div>
{% endif %}